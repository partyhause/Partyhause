FROM node:22.22.0-slim

WORKDIR /app

COPY package.json package-lock.json ./
# --legacy-peer-deps is required: the lockfile is written by a resolver running
# with that flag, and bare `npm ci`/`npm install` recomputes an ideal tree that
# disagrees with it, then refuses to install. See Dockerfile for the full note.
RUN npm ci --legacy-peer-deps

COPY . .

# Workspace link for bare '@partyhause/core' imports. npm ci runs before
# COPY, so packages/ did not exist at install time and npm could not create
# the symlink; without it tsx can only resolve the specifier through tsconfig
# path fallback, which is not deterministic across restarts. Mirrors
# Dockerfile.api's runtime-stage link.
RUN mkdir -p node_modules/@partyhause && ln -sfn ../../packages/core node_modules/@partyhause/core

# Prisma warns it cannot detect libssl on the slim image and defaults to
# openssl-1.1.x; install OpenSSL so the engines resolve properly.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

EXPOSE 5173 3001

CMD ["npm", "run", "dev"]
