            "size": 23137,
            "mimeType": "text/javascript",
            "text": "import { apiGet, apiPost, apiPut, apiDelete } from \"/src/lib/api-client.ts\";\n// Normalize an event coming from the API so it matches the shape the UI\n// expects (backward-compat for events missing the new multi-day fields).\nconst normalizeEvent = (event)=>({\n        ...event,\n        description: event.description ?? null,\n        start_date: event.start_date || event.event_date || event.date,\n        end_date: event.end_date || event.event_date || event.date,\n        event_type: event.event_type || 'single_day'\n    });\nexport const eventService = {\n    // Fetch all events for the current user\n    getUserEvents: async (userId)=>{\n        try {\n            const { data, error } = await apiGet('/api/events');\n            if (error) {\n                // No fallback query needed for the API; just surface an empty list.\n                return [];\n            }\n            const events = data?.events || [];\n            // The API already filters to events the user hosts / co-hosts / is invited\n            // to, so we don't need to filter by host_id here. We still keep the param\n            // for signature compatibility.\n            void userId;\n            return events.map(normalizeEvent);\n        } catch (error) {\n            return [];\n        }\n    },\n    // Create a new event\n    createEvent: async (event)=>{\n        try {\n            const { data, error } = await apiPost('/api/events', event);\n            if (error) throw error;\n            const created = data?.event;\n            return created ? normalizeEvent(created) : null;\n        } catch (error) {\n            return null;\n        }\n    },\n    // Update an event\n    updateEvent: async (id, updates)=>{\n        try {\n            const { data, error } = await apiPut(`/api/events/${id}`, updates);\n            if (error) throw error;\n            const updated = data?.event;\n            return updated ? normalizeEvent(updated) : null;\n        } catch (error) {\n            return null;\n        }\n    },\n    /**\n   * Move a draft to published.\n   *\n   * WHY THIS IS NOT `updateEvent(id, { status: 'published' })`\n   * `updateEvent` swallows its error and answers `null`, which is survivable\n   * for a field edit the user can retry by looking at the form. Publishing is\n   * a state change with specific refusals, and the only one that matters most\n   * (\"that is not a valid status\") is now a 400 rather than a 500 since\n   * server/lib/event-status.ts landed. A caller that cannot see the reason has\n   * to guess, so this returns the message instead of discarding it.\n   *\n   * Publishing is what `server/lib/mvp-invitations.ts:253-260` requires before\n   * an invitation can be sent, so a web host could never invite anybody: every\n   * event this client created stayed a draft forever.\n   *\n   * @param id The event to publish.\n   * @returns The updated event, or the reason it was refused.\n   */ publishEvent: async (id)=>{\n        const { data, error } = await apiPut(`/api/events/${id}`, {\n            status: 'published'\n        });\n        if (error) {\n            return {\n                error: error.message || 'The event could not be published.'\n            };\n        }\n        if (!data?.event) {\n            return {\n                error: 'The server accepted the change but returned no event.'\n            };\n        }\n        return {\n            event: normalizeEvent(data.event)\n        };\n    },\n    // Delete an event\n    deleteEvent: async (id)=>{\n        try {\n            const { error } = await apiDelete(`/api/events/${id}`);\n            if (error) throw error;\n            return true;\n        } catch (error) {\n            return false;\n        }\n    },\n    // Get event guests\n    getEventGuests: async (eventId)=>{\n        try {\n            const { data, error } = await apiGet(`/api/guests?eventId=${encodeURIComponent(eventId)}`);\n            if (error) throw error;\n            return data?.guests || [];\n        } catch (error) {\n            return [];\n        }\n    },\n    // Get single event by id\n    getEventById: async (id)=>{\n        try {\n            const { data, error } = await apiGet(`/api/events/${id}`);\n            if (error) throw error;\n            const event = data?.event;\n            if (!event) return null;\n            return normalizeEvent(event);\n        } catch (error) {\n            return null;\n        }\n    },\n    // Add guest to event\n    addGuest: async (guest)=>{\n        try {\n            // The API expects { eventId, guests: [...] } (bulk import shape).\n            const payload = {\n                eventId: guest.event_id,\n                guests: [\n                    {\n                        name: guest.name,\n                        // guests.email is NOT NULL server-side; '' means \"no email\".\n                        email: guest.email || '',\n                        phone: guest.phone || null,\n                        plusOnes: guest.plus_ones ?? 0\n                    }\n                ]\n            };\n            const { data, error } = await apiPost('/api/guests', payload);\n            if (error) throw error;\n            const created = data?.guests?.[0];\n            return created || null;\n        } catch (error) {\n            return null;\n        }\n    },\n    // Update guest\n    updateGuest: async (id, updates)=>{\n        try {\n            // Map UI field names to the API's expected body shape.\n            const body = {};\n            if (updates.name !== undefined) body.name = updates.name;\n            if (updates.email !== undefined) body.email = updates.email;\n            if (updates.phone !== undefined) body.phone = updates.phone;\n            if (updates.plus_ones !== undefined) body.plusOnes = updates.plus_ones;\n            // Canonical API fields\n            if (updates.rsvp_status !== undefined) body.rsvpStatus = updates.rsvp_s