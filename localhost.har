          "content": {
            "size": 7044,
            "mimeType": "text/javascript",
            "text": "/** Build the RSVP surface: public read, account-bound write. */ export function createRsvpResource(transport) {\n    return {\n        resolve: (token)=>transport.request('/api/rsvp/resolve', {\n                method: 'POST',\n                body: {\n                    token\n                },\n                anonymous: true\n            }),\n        respond: (token, status, expectedRevision)=>transport.request('/api/rsvp', {\n                method: 'PUT',\n                // The service rejects unknown keys outright (`exactKeys`), so this\n                // body carries exactly these three and nothing else.\n                body: {\n                    token,\n                    status,\n                    expectedRevision\n                },\n                privacy: true\n            })\n    };\n}\n\n//# sourceMappingURL=data:application/json;base64,"
          },
