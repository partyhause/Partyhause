          "content": {
            "size": 14209,
            "mimeType": "text/javascript",
            "text": "/**\n * The partyboard — event planning operations room.\n *\n * Wraps `/api/partyboard/*` so both clients reach the board through one\n * typed surface instead of hand-rolled fetch calls. The web app previously\n * called `/api/partyboard/*` at 7 sites with no typed client; this resource\n * closes that gap.\n *\n * WHAT IS NOT HERE YET\n *   `POST /api/partyboard/stickies/:id/convert-to-task` accepts optional\n *   `due_date`, `priority`, `description`, `assignee_id` from the migration\n *   `20261112000000_partyboard_operations_room`. Those fields are exposed in\n *   `CreateTaskInput` below.\n */ export function createPartyBoardResource(t) {\n    const getBudget = async (eventId)=>{\n        const result = await t.request(`/api/partyboard/tasks?event_id=${eventId}`, {\n            method: 'GET'\n        });\n        if (result.error) return {\n            data: null,\n            error: result.error\n        };\n        const tasks = result.data?.tasks ?? [];\n        const estimated_total = tasks.reduce((sum, t)=>sum + (t.estimated_cost ?? 0), 0);\n        const actual_total = tasks.reduce((sum, t)=>sum + (t.actual_cost ?? 0), 0);\n        const open_count = tasks.filter((t)=>t.status === 'open').length;\n        const done_count = tasks.filter((t)=>t.status === 'done').length;\n        return {\n            data: {\n                estimated_total,\n                actual_total,\n                task_count: tasks.length,\n                open_count,\n                done_count\n            },\n            error: null\n        };\n    };\n    return {\n        listStickies: (eventId, sessionId)=>{\n            const params = new URLSearchParams({\n                event_id: eventId\n            });\n            if (sessionId) params.append('session_id', sessionId);\n            return t.request(`/api/partyboard/stickies/?${params.toString()}`, {\n                method: 'GET'\n            });\n        },\n        createSticky: (input)=>t.request('/api/partyboard/stickies/', {\n                method: 'POST',\n                body: input\n            }),\n        updateStickyPosition: (input)=>t.request(`/api/partyboard/stickies/${input.sticky_id}/position`, {\n                method: 'PATCH',\n                body: {\n                    position: input.position\n                }\n            }),\n        voteOnSticky: (stickyId)=>t.request(`/api/partyboard/stickies/${stickyId}/vote`, {\n                method: 'PATCH'\n            }),\n        convertToTask: (stickyId, input)=>t.request(`/api/partyboard/stickies/${stickyId}/convert-to-task`, {\n                method: 'POST',\n                body: input ?? {}\n            }),\n        deleteSticky: (stickyId)=>t.request(`/api/partyboard/stickies/${stickyId}`, {\n                method: 'DELETE'\n            }),\n        listTasks: (eventId)=>t.request(`/api/partyboard/tasks?event_id=${eventId}`, {\n                method: 'GET'\n            }),\n        getBudget\n    };\n}\n\n//# sourceMappingURL=data:application/json;base64,"
          },
