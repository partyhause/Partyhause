            "mimeType": "text/javascript",
            "text": "/**\n * @partyhause/core\n *\n * The shared API client. It is written against a storage adapter rather than\n * against `localStorage` directly, because React Native has no `localStorage`\n * and any client that assumes one is web-only by construction.\n *\n * Note that the web app does not consume this package today; it runs a second\n * client at src/lib/api-client.ts. Treat any API contract change as a\n * two-site change until they are unified.\n */ export { paywallCopy } from \"/packages/core/src/paywall-copy.ts\";\nexport { createApiClient } from \"/packages/core/src/client.ts\";\nexport { createTransport } from \"/packages/core/src/http/transport.ts\";\nexport { STORAGE_KEYS, createMemoryStorage } from \"/packages/core/src/http/adapters.ts\";\nexport { createWebStorage, createAsyncStorage, createSecureStoreStorage, SECURE_STORE_MIGRATION_KEY } from \"/packages/core/src/http/storage-adapters.ts\";\nexport { createAccountResource } from \"/packages/core/src/resources/account.ts\";\nexport { createRsvpResource } from \"/packages/core/src/resources/rsvp.ts\";\n// Host-side invitation sending. This is the only call that mints an RSVP\n// token, so it is what makes the `/join/:token` page reachable at all.\nexport { createMvpInvitationsResource } from \"/packages/core/src/resources/invitations.ts\";\n// Required on every `/api/mvp` write. Exported here, not only from ./mvp,\n// because the shared client now carries a command endpoint.\nexport { createMvpIdempotencyKey } from \"/packages/core/src/http/idempotency.ts\";\n// Value exports, not just types: both clients mirror these bounds to trim a\n// transcript before sending rather than discover the limit as a 400. The web\n// client had them hardcoded at AIEventAssistant.tsx:33-34.\nexport { MAX_CHAT_MESSAGES, MAX_CHAT_MESSAGE_CHARS, trimTranscript } from \"/packages/core/src/resources/index.ts\";\nexport * from \"/packages/core/src/types.ts\";\nexport * from \"/packages/core/src/legal.ts\";\nexport * from \"/packages/core/src/app-install.ts\";\n\n//# sourceMappingURL=data:application/json;base64,"
