            "text": "import __vite__cjsImport0_react from \"/node_modules/.vite/deps/react.js?v=7b9090c1\"; const useRef = __vite__cjsImport0_react[\"useRef\"];\nexport function useRenderSafety(componentName, maxRenders = 50) {\n  const renderCount = useRef(0);\n  const lastReset = useRef(Date.now());\n  renderCount.current += 1;\n  const now = Date.now();\n  if (now - lastReset.current > 5e3) {\n    renderCount.current = 1;\n    lastReset.current = now;\n  }\n  if (renderCount.current > maxRenders && true) {\n    throw new Error(`Render loop detected in ${componentName}: ${renderCount.current} renders in five seconds.`);\n  }\n  return renderCount.current;\n}\n\n//# sourceMappingURL=data:application/json;base64,"
