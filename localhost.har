          "content": {
            "size": 5250,
            "mimeType": "text/javascript",
            "text": "import { unwrapOne } from \"/packages/core/src/resources/envelopes.ts\";\n/** Create the account, legal, and permanent-deletion API surface for IOS-MVP-1. */ export function createAccountResource(transport) {\n    return {\n        summary: ()=>transport.request('/api/mvp/account', {\n                method: 'GET'\n            }),\n        createDeletionIntent: (password)=>unwrapOne(transport.request('/api/mvp/account/deletion-intent', {\n                method: 'POST',\n                body: {\n                    password\n                }\n            }), 'deletion'),\n        confirmDeletion: (receipt)=>transport.request('/api/mvp/account/deletion', {\n                method: 'POST',\n                body: {\n                    receipt,\n                    confirmation: 'DELETE'\n                },\n                anonymous: true\n            }),\n        deletionStatus: (receipt)=>unwrapOne(transport.request(`/api/mvp/account/deletion/${encodeURIComponent(receipt)}`, {\n                method: 'GET',\n                anonymous: true\n            }), 'deletion')\n    };\n}\n\n//# sourceMappingURL=data:application/json;base64,"
