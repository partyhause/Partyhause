rentEvent : events.length > 0 ? events[0] : null;\n                            const newEvents = events || [];\n                            return {\n                                events: newEvents,\n                                currentEvent: newCurrent,\n                                isLoading: false\n                            };\n                        });\n                    } catch (error) {\n                        console.warn('Failed to load user events:', error);\n                        set((state)=>({\n                                ...state,\n                                isLoading: false\n                            }));\n                    }\n                };\n                if (typeof window !== 'undefined' && 'requestIdleCallback' in window) {\n                    window.requestIdleCallback(loadEvents);\n                } else {\n                    setTimeout(loadEvents, 100);\n                }\n            } else {\n                set({\n                    user: null,\n                    isAuthenticated: false,\n                    events: [],\n                    currentEvent: null,\n                    guests: [],\n                    loadedEventIds: new Set()\n                });\n            }\n        },\n        setEvents: (events)=>{\n            const normalizedEvents = events.map((event)=>({\n                    ...event\n                }));\n            set({\n                events: normalizedEvents\n            });\n        },\n        setCurrentEvent: async (event)=>{\n            if (!event) {\n                set({\n                    currentEvent: null,\n                    guests: []\n                });\n                return;\n            }\n            try {\n                const fullEvent = await eventService.getEventById(event.id);\n                const guests = await eventService.getEventGuests(event.id);\n                set({\n                    currentEvent: fullEvent ?? event,\n                 