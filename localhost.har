on-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-\\\\[margin\\\\2c opa\\\\] {\\n  transition-property: margin,opa;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-\\\\[width\\\\2c height\\\\2c padding\\\\] {\\n  transition-property: width,height,padding;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-\\\\[width\\\\] {\\n  transition-property: width;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-all {\\n  transition-property: all;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-colors {\\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-opacity {\\n  transition-property: opacity;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-shadow {\\n  transition-property: box-shadow;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-transform {\\n  transition-property: transform;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.delay-1000 {\\n  transition-delay: 1000ms;\\n}\\n.duration-200 {\\n  transition-duration: 200ms;\\n}\\n.duration-300 {\\n  transition-duration: 300ms;\\n}\\n.duration-500 {\\n  transition-duration: 500ms;\\n}\\n.ease-in-out {\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n.ease-linear {\\n  transition-timing-function: linear;\\n}\\n@keyframes enter {\\n\\n  from {\\n    opacity: var(--tw-enter-opacity, 1);\\n    transform: translate3d(var(--tw-enter-translate-x, 0), var(--tw-enter-translate-y, 0), 0) scale3d(var(--tw-enter-scale, 1), var(--tw-enter-scale, 1), var(--tw-enter-scale, 1)) rotate(var(--tw-enter-rotate, 0));\\n  }\\n}\\n@keyframes exit {\\n\\n  to {\\n    opacity: var(--tw-exit-opacity, 1);\\n    transform: translate3d(var(--tw-exit-translate-x, 0), var(--tw-exit-translate-y, 0), 0) scale3d(var(--tw-exit-scale, 1), var(--tw-exit-scale, 1), var(--tw-exit-scale, 1)) rotate(var(--tw-exit-rotate, 0));\\n  }\\n}\\n.animate-in {\\n  animation-name: enter;\\n  animation-duration: 150ms;\\n  --tw-enter-opacity: initial;\\n  --tw-enter-scale: initial;\\n  --tw-enter-rotate: initial;\\n  --tw-enter-translate-x: initial;\\n  --tw-enter-translate-y: initial;\\n}\\n.fade-in-0 {\\n  --tw-enter-opacity: 0;\\n}\\n.zoom-in-95 {\\n  --tw-enter-scale: .95;\\n}\\n.duration-200 {\\n  animation-duration: 200ms;\\n}\\n.duration-300 {\\n  animation-duration: 300ms;\\n}\\n.duration-500 {\\n  animation-duration: 500ms;\\n}\\n.delay-1000 {\\n  animation-delay: 1000ms;\\n}\\n.ease-in-out {\\n  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n.ease-linear {\\n  animation-timing-function: linear;\\n}\\n.running {\\n  animation-play-state: running;\\n}\\n.paused {\\n  animation-play-state: paused;\\n}\\n  /* ============================================ */\\n  /* LIQUID METAL ANIMATION KEYFRAMES            */\\n  /* ============================================ */\\n  \\n  /* Liquid Motion Animations */\\n  @keyframes liquid-ripple {\\n    0% {\\n      transform: scale(0.95);\\n      opacity: 1;\\n    }\\n    50% {\\n      transform: scale(1.05);\\n      opacity: 0.8;\\n    }\\n    100% {\\n      transform: scale(0.95);\\n      opacity: 1;\\n    }\\n  }\\n  \\n  @keyframes liquid-flow {\\n    0%, 100% { \\n      background-position: 0% 50%; \\n    }\\n    50% { \\n      background-position: 100% 50%; \\n    }\\n  }\\n  \\n  @keyframes liquid-morph {\\n    0%, 100% {\\n      transform: translate(0, 0) scale(1);\\n      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;\\n    }\\n    33% {\\n      transform: translate(50px, -30px) scale(1.1);\\n      border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;\\n    }\\n    66% {\\n      transform: translate(-40px, 20px) scale(0.95);\\n      border-radius: 50% 60% 30% 60% / 30% 70% 50% 40%;\\n    }\\n  }\\n  \\n  /* Metallic Shimmer */\\n  @keyframes metal-shimmer {\\n    0% {\\n      background-position: -200% center;\\n    }\\n    100% {\\n      background-position: 200% center;\\n    }\\n  }\\n  \\n  @keyframes shimmer-premium {\\n    0% { \\n      opacity: 0.3;\\n    }\\n    50% {\\n      opacity: 0.6;\\n    }\\n    100% { \\n      opacity: 0.3;\\n    }\\n  }\\n  \\n  /* Smooth Floating */\\n  @keyframes float-smooth {\\n    0%, 100% {\\n      transform: translateY(0px) rotate(0deg);\\n    }\\n    33% {\\n      transform: translateY(-8px) rotate(2deg);\\n    }\\n    66% {\\n      transform: translateY(-4px) rotate(-2deg);\\n    }\\n  }\\n  \\n  @keyframes float-gentle {\\n    0%, 100% { \\n      transform: translateY(0px); \\n    }\\n    50% { \\n      transform: translateY(-8px); \\n    }\\n  }\\n  \\n  /* Glow Pulse Effects */\\n  @keyframes glow-pulse-liquid {\\n    0%, 100% {\\n      box-shadow: \\n        0 0 20px hsla(var(--iridescent-blue-start), 0.2),\\n        0 0 40px hsla(var(--iridescent-blue-start), 0.1);\\n    }\\n    50% {\\n      box-shadow: \\n        0 0 40px hsla(var(--iridescent-blue-start), 0.4),\\n        0 0 80px hsla(var(--iridescent-blue-start), 0.2);\\n    }\\n  }\\n  \\n  @keyframes glow-pulse {\\n    0%, 100% {\\n      box-shadow: 0 0 20px hsla(var(--iridescent-pink-end), 0.3);\\n    }\\n    50% {\\n      box-shadow: 0 0 40px hsla(var(--iridescent-pink-end), 0.6);\\n    }\\n  }\\n  \\n  /* Gradient Shift */\\n  @keyframes gradient-shift {\\n    0%, 100% { \\n      background-position: 0% 50%; \\n    }\\n    50% { \\n      background-position: 100% 50%; \\n    }\\n  }\\n  \\n  /* Particle Float */\\n  @keyframes particle-float {\\n    0%, 100% {\\n      transform: translateY(0) translateX(0) scale(1);\\n      opacity: 0;\\n    }\\n    10% {\\n      opacity: 0.6;\\n    }\\n    90% {\\n      opacity: 0.6;\\n    }\\n    100% {\\n      transform: translateY(-100vh) translateX(50px) scale(0);\\n      opacity: 0;\\n    }\\n  }\\n  \\n  /* Light Sweep */\\n  @keyframes light-sweep {\\n    0%, 100% {\\n      left: -5%;\\n      opacity: 0;\\n    }\\n    50% {\\n      left: 105%;\\n      opacity: 1;\\n    }\\n  }\\n  \\n  /* Legacy Animations - Orange Theme */\\n  @keyframes orange-glow-pulse {\\n    0%, 100% { \\n      filter: drop-shadow(0 2px 8px hsl(var(--orange-500) / 0.4));\\n    }\\n    50% { \\n      filter: drop-shadow(0 4px 16px hsl(var(--orange-400) / 0.6));\\n    }\\n  }\\n\\n  @keyframes orange-pulse {\\n    0%, 100% {\\n      box-shadow: 0 0 20px hsl(var(--orange-500) / 0.2);\\n    }\\n    50% {\\n      box-shadow: 0 0 30px hsl(var(--orange-400) / 0.4);\\n    }\\n  }\\n  \\n  @keyframes cosmic-spin {\\n    0% { transform: rotate(0deg); }\\n    100% { transform: rotate(360deg); }\\n  }\\n\\n@keyframes shimmer {\\n  0% { opacity: 0.5; }\\n  50% { opacity: 0.8; }\\n  100% { opacity: 0.5; }\\n}  /* Page Transitions */\\n\\n  /* ============================================ */\\n  /* LIQUID METAL ANIMATION UTILITIES            */\\n  /* ============================================ */\\n  \\n  /* Liquid Motion Classes */\\n  \\n  /* Metallic Effects */\\n  \\n  /* Float & Glow */\\n  \\n  /* Gradient Animations */\\n  \\n  /* Particle & Light */\\n  \\n  /* Legacy Orange Animations */\\n.\\\\[object-position\\\\:50\\\\%_35\\\\%\\\\] {\\n  -o-object-position: 50% 35%;\\n     object-position: 50% 35%;\\n}\\n\\n/* PartyHause Premium Design System - Mobile aligned tokens */\\n\\n/* ============================================ */\\n/* LIQUID METAL UTILITY CLASSES                */\\n/* ============================================ */\\n\\n/* Solid Color Backgrounds - Burnt Orange Theme */\\n.bg-burnt-orange { background: hsl(var(--burnt-orange)); }\\n.bg-burnt-orange-dark { background: hsl(var(--burnt-orange-dark)); }\\n.bg-burnt-orange-light { background: hsl(var(--burnt-orange-light)); }\\n.bg-dark-base { background: hsl(var(--bg-dark-base)); }\\n.bg-dark-elevated { background: hsl(var(--bg-dark-elevated)); }\\n.bg-dark-panel { background: hsl(var(--bg-dark-panel)); }\\n\\n/* Accent Backgrounds */\\n.bg-accent-pink { background: hsl(var(--accent-pink)); }\\n.bg-accent-purple { background: hsl(var(--accent-purple)); }\\n.bg-accent-amber { background: hsl(var(--accent-amber)); }\\n.bg-accent-coral { background: hsl(var(--accent-coral)); }\\n\\n/* Solid Color Text - Burnt Orange Theme */\\n.text-burnt-orange { color: hsl(var(--burnt-orange)); }\\n.text-burnt-orange-dark { color: hsl(var(--burnt-orange-dark)); }\\n.text-burnt-orange-light { color: hsl(var(--burnt-orange-light)); }\\n.text-white { color: hsl(var(--text-white)); }\\n.text-primary { color: hsl(var(--text-primary)); }\\n.text-secondary { color: hsl(var(--text-secondary)); }\\n\\n/* Liquid Metal Shadows */\\n.shadow-liquid-sm { box-shadow: var(--shadow-liquid-sm); }\\n.shadow-liquid-md { box-shadow: var(--shadow-liquid-md); }\\n.shadow-liquid-lg { box-shadow: var(--shadow-liquid-lg); }\\n.shadow-liquid-xl { box-shadow: var(--shadow-liquid-xl); }\\n.shadow-glow-blue { box-shadow: var(--shadow-glow-blue); }\\n.shadow-glow-purple { box-shadow: var(--shadow-glow-purple); }\\n.shadow-glow-pink { box-shadow: var(--shadow-glow-pink); }\\n\\n/* Legacy Support - Orange Theme */\\n.bg-orange { background: hsl(var(--burnt-orange)); }\\n.bg-orange-dark { background: hsl(var(--burnt-orange-dark)); }\\n.text-primary-glow { color: hsl(var(--burnt-orange)); }\\n.text-orange { color: hsl(var(--burnt-orange)); }\\n.shadow-orange { box-shadow: var(--shadow-floating); }\\n.shadow-orange-lg { box-shadow: var(--shadow-elevated); }\\n\\n/* ============================================ */\\n/* PREMIUM POLISH & MICRO-INTERACTIONS */\\n/* ============================================ */\\n\\n/* Enhanced Button Interactions */\\n.btn-floating {\\n  position: relative;\\n  overflow: hidden;\\n  transform-style: preserve-3d;\\n}\\n\\n.btn-floating::before {\\n  content: '';\\n  position: absolute;\\n  top: 0;\\n  left: -100%;\\n  width: 100%;\\n  height: 100%;\\n  background: rgba(255, 255, 255, 0.1);\\n  transition: left 0.5s;\\n}\\n\\n.btn-floating:hover::before {\\n  left: 100%;\\n}\\n\\n.btn-floating:active {\\n  transform: translateY(1px) scale(0.98);\\n}\\n\\n.btn-floating:focus {\\n  outline: none;\\n  box-shadow: var(--shadow-floating-hover), 0 0 0 4px hsl(var(--orange-200) / 0.3);\\n}\\n\\n/* Enhanced Card Interactions */\\n.modern-card {\\n  transform-style: preserve-3d;\\n  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\\n}\\n\\n.modern-card:hover {\\n  transform: translateY(-8px) rotateX(2deg);\\n  box-shadow: \\n    0 20px 40px rgba(0, 0, 0, 0.1),\\n    0 0 0 1px hsl(var(--orange-200) / 0.2);\\n}\\n\\n  .modern-card-elevated {\\n    transform-style: preserve-3d;\\n    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\\n    background: hsl(var(--bg-primary));\\n    color: hsl(var(--text-primary));\\n  }.modern-card-elevated:hover {\\n  transform: translateY(-12px) rotateX(3deg);\\n  box-shadow: \\n    0 25px 50px rgba(0, 0, 0, 0.15),\\n    0 0 0 1px hsl(var(--orange-300) / 0.3);\\n}\\n\\n/* Enhanced Icon Button 3D Effects */\\n.icon-button-3d {\\n  perspective: 100px;\\n  transform-style: preserve-3d;\\n  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\\n  position: relative;\\n}\\n\\n.icon-button-3d::before {\\n  content: '';\\n  position: absolute;\\n  top: 0;\\n  left: 0;\\n  right: 0;\\n  bottom: 0;\\n  border-radius: inherit;\\n  background: rgba(255, 255, 255, 0.1);\\n  opacity: 0;\\n  transition: opacity 0.3s ease;\\n}\\n\\n.icon-button-3d:hover::before {\\n  opacity: 1;\\n}\\n\\n.icon-button-3d:hover {\\n  transform: translateY(-4px) rotateX(8deg) scale(1.05);\\n  box-shadow: \\n    0 15px 25px rgba(0, 0, 0, 0.15),\\n    inset 0 1px 0 rgba(255, 255, 255, 0.2);\\n}\\n\\n.icon-button-3d:active {\\n  transform: translateY(-2px) rotateX(4deg) scale(1.02);\\n}\\n\\n/* Premium Input Enhancements */\\n.input-soft {\\n  position: relative;\\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n\\n.input-soft:focus {\\n  transform: translateY(-1px);\\n  box-shadow: \\n    0 8px 16px rgba(0, 0, 0, 0.1),\\n    0 0 0 4px hsl(var(--orange-200) / 0.3);\\n}\\n\\n.input-soft:hover:not(:focus) {\\n  transform: translateY(-0.5px);\\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);\\n}\\n\\n/* Advanced Animations */\\n@keyframes float-gentle {\\n  0%, 100% { transform: translateY(0px); }\\n  50% { transform: translateY(-8px); }\\n}\\n\\n@keyframes pulse-premium {\\n  0%, 100% { \\n    opacity: 1; \\n    transform: scale(1);\\n  }\\n  50% { \\n    opacity: 0.8; \\n    transform: scale(1.02);\\n  }\\n}\\n\\n@keyframes shimmer-premium {\\n  0% { \\n    background-position: -200% 0; \\n    opacity: 0;\\n  }\\n  50% {\\n    opacity: 1;\\n  }\\n  100% { \\n    background-position: 200% 0; \\n    opacity: 0;\\n  }\\n}\\n\\n@keyframes glow-pulse {\\n  0%, 100% {\\n    box-shadow: 0 0 20px hsl(var(--orange-400) / 0.3);\\n  }\\n  50% {\\n    box-shadow: 0 0 40px hsl(var(--orange-400) / 0.6);\\n  }\\n}\\n\\n/* Premium Animation Classes */\\n.float-gentle {\\n  animation: float-gentle 4s ease-in-out infinite;\\n}\\n\\n.pulse-premium {\\n  animation: pulse-premium 3s ease-in-out infinite;\\n}\\n\\n  .shimmer-premium {\\n    background: rgba(217, 151, 6, 0.1);\\n    animation: shimmer-premium 3s infinite;\\n  }.glow-pulse {\\n  animation: glow-pulse 2s ease-in-out infinite;\\n}\\n\\n/* Scroll-triggered Animations */\\n.scroll-fade-in {\\n  opacity: 0;\\n  transform: translateY(30px);\\n  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n\\n.scroll-fade-in.visible {\\n  opacity: 1;\\n  transform: translateY(0);\\n}\\n\\n.scroll-slide-left {\\n  opacity: 0;\\n  transform: translateX(-50px);\\n  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n\\n.scroll-slide-left.visible {\\n  opacity: 1;\\n  transform: translateX(0);\\n}\\n\\n.scroll-slide-right {\\n  opacity: 0;\\n  transform: translateX(50px);\\n  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n\\n.scroll-slide-right.visible {\\n  opacity: 1;\\n  transform: translateX(0);\\n}\\n\\n/* Glass Morphism Effects */\\n.glass-card {\\n  background: rgba(255, 255, 255, 0.85);\\n  backdrop-filter: blur(20px);\\n  -webkit-backdrop-filter: blur(20px);\\n  border: 1px solid rgba(255, 255, 255, 0.2);\\n  box-shadow: \\n    0 8px 32px rgba(0, 0, 0, 0.1),\\n    inset 0 1px 0 rgba(255, 255, 255, 0.2);\\n}\\n\\n.glass-card-dark {\\n  background: rgba(0, 0, 0, 0.4);\\n  backdrop-filter: blur(20px);\\n  -webkit-backdrop-filter: blur(20px);\\n  border: 1px solid rgba(255, 255, 255, 0.1);\\n  box-shadow: \\n    0 8px 32px rgba(0, 0, 0, 0.3),\\n    inset 0 1px 0 rgba(255, 255, 255, 0.1);\\n}\\n\\n/* Status Indicators with Premium Animation */\\n.status-dot {\\n  width: 12px;\\n  height: 12px;\\n  border-radius: 50%;\\n  position: relative;\\n  display: inline-block;\\n}\\n\\n.status-online {\\n  background: hsl(var(--success-500));\\n  box-shadow: 0 0 0 0 hsl(var(--success-400) / 0.7);\\n  animation: status-pulse 2s infinite;\\n}\\n\\n.status-busy {\\n  background: hsl(var(--orange-500));\\n  box-shadow: 0 0 0 0 hsl(var(--orange-400) / 0.7);\\n  animation: status-pulse 2s infinite;\\n}\\n\\n.status-offline {\\n  background: hsl(var(--text-tertiary));\\n}\\n\\n@keyframes status-pulse {\\n  0% {\\n    transform: scale(0.95);\\n    box-shadow: 0 0 0 0 currentColor;\\n  }\\n  70% {\\n    transform: scale(1);\\n    box-shadow: 0 0 0 10px transparent;\\n  }\\n  100% {\\n    transform: scale(0.95);\\n    box-shadow: 0 0 0 0 transparent;\\n  }\\n}\\n\\n/* Loading States */\\n.loading-shimmer {\\n  background: hsl(var(--bg-dark-elevated));\\n  animation: loading-shimmer 1.5s infinite;\\n}\\n\\n@keyframes loading-shimmer {\\n  0% {\\n    opacity: 0.5;\\n  }\\n  50% {\\n    opacity: 0.8;\\n  }\\n  100% {\\n    opacity: 0.5;\\n  }\\n}\\n\\n/* Interactive Feedback */\\n.interactive-feedback {\\n  position: relative;\\n  overflow: hidden;\\n}\\n\\n.interactive-feedback::after {\\n  content: '';\\n  position: absolute;\\n  top: 50%;\\n  left: 50%;\\n  width: 0;\\n  height: 0;\\n  border-radius: 50%;\\n  background: rgba(255, 255, 255, 0.3);\\n  transform: translate(-50%, -50%);\\n  transition: width 0.3s, height 0.3s;\\n}\\n\\n.interactive-feedback:active::after {\\n  width: 300px;\\n  height: 300px;\\n}\\n\\n/* Accessibility Enhancements */\\n.focus-visible {\\n  outline: 2px solid hsl(var(--orange-500));\\n  outline-offset: 2px;\\n}\\n\\n.reduced-motion {\\n  animation-duration: 0.01s !important;\\n  animation-iteration-count: 1 !important;\\n  transition-duration: 0.01s !important;\\n}\\n\\n@media (prefers-reduced-motion: reduce) {\\n  .float-gentle,\\n  .pulse-premium,\\n  .shimmer-premium,\\n  .glow-pulse {\\n    animation: none;\\n  }\\n  \\n  .modern-card,\\n  .modern-card-elevated,\\n  .icon-button-3d,\\n  .btn-floating {\\n    transition-duration: 0.1s;\\n  }\\n}\\n  \\n  .hover\\\\:bg-orange-50:hover { background-color: hsl(var(--orange-50)); }\\n  .hover\\\\:bg-orange-100:hover { background-color: hsl(var(--orange-100)); }\\n  .hover\\\\:bg-orange-700:hover { background-color: hsl(var(--orange-700)); }\\n  \\n  .hover\\\\:text-orange-500:hover { color: hsl(var(--orange-500)); }\\n  .hover\\\\:text-orange-600:hover { color: hsl(var(--orange-600)); }\\n\\n.file\\\\:mr-4::file-selector-button {\\n  margin-right: 1rem;\\n}\\n\\n.file\\\\:rounded-md::file-selector-button {\\n  border-radius: var(--radius-lg);\\n}\\n\\n.file\\\\:border-0::file-selector-button {\\n  border-width: 0px;\\n}\\n\\n.file\\\\:bg-primary::file-selector-button {\\n  background-color: hsl(var(--primary));\\n}\\n\\n.file\\\\:bg-transparent::file-selector-button {\\n  backgroun