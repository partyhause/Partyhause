fication: true,\n                    error: error.message\n                };\n            }\n            return {\n                success: false,\n                error: errorMessage(error)\n            };\n        }\n    },\n    /**\n   * Create an account and sign the user in.\n   *\n   * The route returns a token + user once the address is confirmed, so both\n   * storage keys are written immediately after signup.\n   */ signUp: async (email, password, name, consent)=>{\n        try {\n            const data = await apiPostAuth('/api/auth/signup/', {\n                email,\n                password,\n                name,\n                ...consent\n            });\n            // Store token + user only when the server issues a token (confirmed address).\n            // When the address still needs confirmation, no token is issued and\n            // nothing is stored — the user must verify their email before signing in.\n            if (data.token) {\n                setStoredToken(data.token);\n                setStoredUser(data.user);\n            }\n            return {\n                success: true,\n                user: data.user,\n                email_verified: data.user.email_verified ?? false,\n                awaitingVerification: !data.token,\n                message: data.message ?? 'Check your email for a confirmation link before signing in.'\n            };\n        } catch (error) {\n            return {\n                success: false,\n                error: errorMessage(error)\n            };\n        }\n    },\n    /**\n   * Create an account from an invitation, and DO sign the user in.\n   *\n   * The only signup path that establishes a session, because it is the only one\n   * where the address is already proven: the invitation token was mailed to it,\n   * and the server re-checks that the token resolves to this exact address\n   * before it returns anything. Without this the invitee would have to leave\n   * for their inbox a second