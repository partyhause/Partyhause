          "content": {
            "size": 51078,
            "mimeType": "text/javascript",
            "text": "/**\n * Typed resource modules, one per API family.\n *\n * Paths and verbs here were taken from an AST walk of server/routes/*.ts, not\n * from memory.\n */ import { unwrapList, unwrapOne } from \"/packages/core/src/resources/envelopes.ts\";\nexport { createPartyBoardResource } from \"/packages/core/src/resources/partyboard.ts\";\nexport { createAiResource, trimTranscript, MAX_CHAT_MESSAGES, MAX_CHAT_MESSAGE_CHARS } from \"/packages/core/src/resources/ai.ts\";\nexport { createBillingResource } from \"/packages/core/src/resources/billing.ts\";\nexport { createOnboardingResource } from \"/packages/core/src/resources/onboarding.ts\";\nexport { createEventsResource } from \"/packages/core/src/resources/legacy-events.ts\";\nexport { createGuestsResource } from \"/packages/core/src/resources/legacy-guests.ts\";\n/**\n * Translate a caller's block into the body `/api/timeline` actually reads.\n *\n * `server/routes/timeline.ts:59-71` destructures `eventId`, `startTime`,\n * `hostNotes`, `guestVisible`, `notifyBefore` and `assignedTo`. Sending the\n * snake_case field names, which is what `Partial<TimelineBlock>` produced,\n * left `eventId` and `startTime` undefined and the route answered\n * 400 \"eventId, label, startTime, duration, and type are required\" no matter\n * what the caller passed. Nothing had ever called it, so nothing observed it.\n *\n * Keys absent from `input` stay absent, because PUT treats `undefined` as\n * \"leave alone\" and an explicit null as \"clear\".\n *\n * @param input Caller-facing block fields.\n * @returns The wire body, with only the supplied keys present.\n */ function toTimelineWire(input) {\n    const pairs = [\n        [\n            'eventId',\n            input.event_id\n        ],\n        [\n            'label',\n            input.label\n        ],\n        [\n            'startTime',\n            input.start_time\n        ],\n        [\n            'duration',\n            input.duration\n        ],\n        [\n            'type',\n            input.type\n        ],\n        [\n            'description',\n            input.description\n        ],\n        [\n            'hostNotes',\n            input.host_notes\n        ],\n        [\n            'guestVisible',\n            input.guest_visible\n        ],\n        [\n            'notifyBefore',\n            input.notify_before\n        ],\n        [\n            'location',\n            input.location\n        ],\n        [\n            'assignedTo',\n            input.assigned_to\n        ],\n        [\n            'orderIndex',\n            input.order_index\n        ]\n    ];\n    const body = {};\n    for (const [key, value] of pairs){\n        if (value !== undefined) body[key] = value;\n    }\n    return body;\n}\nexport function createTimelineResource(t) {\n    return {\n        listForEvent: (eventId)=>unwrapList(t.request(`/api/timeline/${encodeURIComponent(eventId)}`, {\n                method: 'GET'\n            }), 'blocks'),\n        // Both writes answer `{ block, success }`, so both unwrap. They previously\n        // typed the envelope as the block itself, which would have handed callers\n        // an object with no `id` and no failure to report.\n        create: (input)=>unwrapOne(t.request('/api/timeline', {\n                method: 'POST',\n                body: toTimelineWire(input)\n            }), 'block'),\n        update: (id, input)=>unwrapOne(t.request(`/api/timeline/${encodeURIComponent(id)}`, {\n                method: 'PUT',\n                body: toTimelineWire(input)\n            }), 'block'),\n        remove: (id)=>t.request(`/api/timeline/${encodeURIComponent(id)}`, {\n                method: 'DELETE'\n            })\n    };\n}\nexport function createPollsResource(t) {\n    return {\n        list: (eventId)=>unwrapList(t.request('/api/polls', {\n                method: 'GET',\n                query: {\n                    eventId\n                }\n            }), 'polls'),\n        get: (id)=>unwrapOne(t.request(`/api/polls/${encodeURIComponent(id)}`, {\n                method: 'GET'\n            }), 'poll'),\n        create: (input)=>unwrapOne(t.request('/api/polls', {\n                method: 'POST',\n                body: input\n            }), 'poll'),\n        vote: (pollId, optionId)=>unwrapOne(t.request(`/api/polls/${encodeURIComponent(pollId)}/vote`, {\n                method: 'POST',\n                body: {\n                    optionId\n                }\n            }), 'poll'),\n        close: (pollId)=>unwrapOne(t.request(`/api/polls/${encodeURIComponent(pollId)}/close`, {\n                method: 'POST'\n            }), 'poll')\n    };\n}\nexport function createPartyCrewResource(t) {\n    return {\n        members: (options)=>t.request('/api/partycrew/members', {\n                method: 'GET',\n                query: {\n                    limit: options?.limit,\n                    offset: options?.offset,\n                    // The route compares against the literal string 'true'.\n                    include_mutual_count: options?.includeMutualCount ? 'true' : undefined\n                }\n            }),\n        crewingWith: (userId, options)=>t.request('/api/partycrew/crewing-with', {\n                method: 'GET',\n                query: {\n                    userId,\n                    limit: options?.limit,\n                    offset: options?.offset\n                }\n            }),\n        status: (creatorId)=>t.request('/api/partycrew/toggle', {\n                method: 'GET',\n                query: {\n                    creatorId\n                }\n            }),\n        toggle: (creatorId, action)=>t.request('/api/partycrew/toggle', {\n                method: 'POST',\n                body: {\n                    creatorId,\n                    action\n                }\n            }),\n        requests: (type = 'received')=>t.request('/api/partycrew/requests', {\n                method: 'GET',\n                query: {\n                    type\n                }\n            }),\n        cancelRequest: (requestId)=>t.request('/api/partycrew/requests', {\n                method: 'DELETE',\n                body: {\n                    requestId\n                }\n            })\n    };\n}\nexport function createFeedResource(t) {\n    return {\n        like: (postId)=>t.request(`/api/feed/posts/${postId}/like`, {\n                method: 'POST'\n            }),\n        unlike: (postId)=>t.request(`/api/feed/posts/${postId}/like`, {\n                method: 'DELETE'\n            }),\n        comments: (postId, options)=>t.request(`/api/feed/posts/${postId}/comments`, {\n                method: 'GET',\n                query: {\n                    limit: options?.limit,\n                    cursor: options?.cursor\n                }\n            }),\n        comment: (postId, body, parentCommentId)=>t.request(`/api/feed/posts/${postId}/comments`, {\n                method: 'POST',\n                body: {\n                    body,\n                    parent_comment_id: parentCommentId ?? null\n                }\n            }),\n        share: (postId, sharedTo)=>t.request(`/api/feed/posts/${postId}/share`, {\n                method: 'POST',\n                body: {\n                    shared_to: sharedTo ?? 'external'\n                }\n            }),\n        crew: (options)=>t.request('/api/feed/crew', {\n                method: 'GET',\n                query: {\n                    limit: options?.limit,\n                    cursor: options?.cursor,\n                    content_type: options?.contentType\n                }\n            }),\n        markSeen: (postIds)=>unwrapOne(t.request('/api/feed/seen', {\n                method: 'POST',\n                body: {\n                    post_ids: postIds\n                }\n            }), 'marked')\n    };\n}\nexport function createUsersResource(t) {\n    return {\n        suggested: ()=>unwrapList(t.request('/api/users/suggested', {\n                method: 'GET'\n            }), 'suggestions'),\n        // Deliberately NOT unwrapped. GET /api/users/:id answers with the profile\n        // object itself; asking for a `profile` key returned null with no error,\n        // so every caller saw an empty profile and no failure to report.\n        get: (id)=>t.request(`/api/users/${encodeURIComponent(id)}`, {\n                method: 'GET'\n            }),\n        updateProfile: (input)=>unwrapOne(t.request('/api/users/me/profile', {\n                method: 'PUT',\n                body: input\n            }), 'profile'),\n        // Not unwrapped: the route answers with the availability object itself.\n        checkUsername: (username)=>t.request('/api/users/username-available', {\n                method: 'GET',\n                query: {\n                    username\n                }\n            }),\n        onboardingState: ()=>t.request('/api/users/me/onboarding', {\n                method: 'GET'\n            }),\n        skipOnboarding: ()=>t.request('/api/users/me/onboarding/skip', {\n                method: 'POST'\n            }),\n        // Also not unwrapped. The route returns `{ profile, unchanged }` and both\n        // halves matter: `unchanged` is how a client knows a resubmit of the same\n        // handle was a no-op rather than a fresh claim that restarted the cooldown.\n        setUsername: (username)=>t.request('/api/users/me/username', {\n                method: 'PUT',\n                body: {\n                    username\n                }\n            })\n    };\n}\nexport function createNotificationsResource(t) {\n    return {\n        list: ()=>unwrapList(t.request('/api/notifications', {\n                method: 'GET'\n            }), 'notifications'),\n        // POST /api/notifications does not exist; the route is /mark-read and it\n        // takes an array of ids.\n        markRead: (id)=>t.request('/api/notifications/mark-read', {\n                method: 'POST',\n                body: {\n                    ids: [\n                        id\n                    ]\n                }\n            })\n    };\n}\nexport function createStorageResource(t) {\n    return {\n        urlFor: (blobName)=>t.request(`/api/storage/url/${encodeURIComponent(blobName)}`, {\n                method: 'GET'\n            }),\n        remove: (blobName)=>t.request(`/api/storage/${encodeURIComponent(blobName)}`, {\n                method: 'DELETE'\n            })\n    };\n}\nexport function createEmailLogsResource(t) {\n    return {\n        listForEvent: (eventId)=>unwrapList(t.request('/api/email-logs', {\n                method: 'GET',\n                query: {\n                    eventId\n                }\n            }), 'email_logs'),\n        create: (input)=>unwrapOne(t.request('/api/email-logs', {\n                method: 'POST',\n                body: input\n            }), 'email_log'),\n        update: (id, input)=>unwrapOne(t.request(`/api/email-logs/${encodeURIComponent(id)}`, {\n                method: 'PUT',\n                body: input\n            }), 'email_log')\n    };\n}\nexport function createEmailResource(t) {\n    return {\n        send: (to, subject, html)=>t.request('/api/send-email', {\n                method: 'POST',\n                body: {\n                    to,\n                    subject,\n                    html\n                }\n            })\n    };\n}\n\n//# sourceMappingURL=data:application/json;base64,"
