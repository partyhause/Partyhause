          "content": {
            "size": 4610,
            "mimeType": "text/javascript",
            "text": "/** Construct the fixed, host-only invitation resource used by the iOS MVP. */ export function createMvpInvitationsResource(transport) {\n    return {\n        getForEvent: (eventId)=>transport.request(`/api/mvp/events/${encodeURIComponent(eventId)}/invitations`, {\n                method: 'GET'\n            }),\n        send: (eventId, guestIds, idempotencyKey)=>transport.request(`/api/mvp/events/${encodeURIComponent(eventId)}/invitations/send`, {\n                method: 'POST',\n                body: {\n                    guestIds\n                },\n                headers: {\n                    'Idempotency-Key': idempotencyKey\n                }\n            })\n    };\n}\n\n//# sourceMappingURL=data:application/json;base64,"
