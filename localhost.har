            "size": 159491,
            "mimeType": "text/javascript",
            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/index.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"/Users/oluwaferanmi/Partyhause/src/index.css\"\nconst __vite__css = \"/* Mobile-aligned design tokens\\n   Source: apps/mobile/constants/theme.ts and apps/mobile/tailwind.config.js\\n   Generated from hex values, converted to HSL for web CSS vars\\n   Cream is the background surface family per docs/BRAND.md s12.1\\n*/\\n\\n:root {\\n  /* Coral */\\n  --coral-50: 8 100% 97%; /* #FFF2F0 */\\n  --coral-100: 10 100% 94%; /* #FFE5E0 */\\n  --coral-200: 10 100% 88%; /* #FFCCC2 */\\n  --coral-300: 10 100% 79%; /* #FFA694 */\\n  --coral-400: 9 100% 70%; /* #FF7D66 */\\n  --coral-500: 9 100% 60%; /* #FF5233 */\\n  --coral-600: 8 83% 51%; /* #EA361A */\\n  --coral-700: 7 79% 42%; /* #C02A16 */\\n  --coral-800: 6 74% 34%; /* #972317 */\\n  --coral-900: 6 68% 28%; /* #782117 */\\n  --coral-950: 6 73% 16%; /* #46110B */\\n\\n  /* Magenta */\\n  --magenta-50: 332 100% 97%; /* #FFF0F7 */\\n  --magenta-100: 329 100% 94%; /* #FFE0F0 */\\n  --magenta-200: 331 97% 88%; /* #FEC3E0 */\\n  --magenta-300: 330 92% 80%; /* #FB9DCC */\\n  --magenta-400: 330 86% 70%; /* #F471B3 */\\n  --magenta-500: 330 81% 60%; /* #EC4699 */\\n  --magenta-600: 331 74% 51%; /* #DF267F */\\n  --magenta-700: 332 70% 42%; /* #B62066 */\\n  --magenta-800: 333 66% 34%; /* #901D51 */\\n  --magenta-900: 333 62% 28%; /* #741B43 */\\n  --magenta-950: 333 66% 16%; /* #440E26 */\\n\\n  /* Cream - background surface family */\\n  --cream-50: 38 35% 95%; /* #F5F0E6 */\\n  --cream-100: 38 35% 94%; /* #F5F1EA */\\n  --cream-200: 37 34% 88%; /* #EBE3D6 */\\n  --cream-300: 37 35% 79%; /* #DCCEB7 */\\n  --cream-400: 38 35% 70%; /* #CDBA98 */\\n  --cream-500: 38 35% 60%; /* #BDA375 */\\n  --cream-600: 38 35% 51%; /* #AE8E56 */\\n  --cream-700: 38 35% 42%; /* #917546 */\\n  --cream-800: 38 35% 34%; /* #755F38 */\\n  --cream-900: 38 35% 28%; /* #604E2E */\\n  --cream-950: 39 34% 16%; /* #372D1B */\\n\\n  /* Teal - cool accent, category surfaces */\\n  --teal-50: 171 47% 97%; /* #F4FBFA */\\n  --teal-100: 172 48% 94%; /* #E8F7F5 */\\n  --teal-200: 170 48% 88%; /* #D2EFEA */\\n  --teal-300: 171 48% 79%; /* #B0E3DB */\\n  --teal-400: 170 48% 70%; /* #8ED7CB */\\n  --teal-500: 170 48% 60%; /* #68CABA */\\n  --teal-600: 170 48% 51%; /* #46BEAA */\\n  --teal-700: 170 48% 42%; /* #389F8D */\\n  --teal-800: 170 48% 34%; /* #2D8072 */\\n  --teal-900: 170 48% 28%; /* #256A5E */\\n  --teal-950: 171 48% 16%; /* #153C36 */\\n\\n  /* Periwinkle - evening accent */\\n  --periwinkle-50: 244 100% 97%; /* #F1F0FF */\\n  --periwinkle-100: 244 100% 94%; /* #E2E0FF */\\n  --periwinkle-200: 244 100% 88%; /* #C6C2FF */\\n  --periwinkle-300: 244 100% 79%; /* #9B94FF */\\n  --periwinkle-400: 244 100% 70%; /* #7066FF */\\n  --periwinkle-500: 244 100% 60%; /* #4133FF */\\n  --periwinkle-600: 244 100% 51%; /* #1605FF */\\n  --periwinkle-700: 244 100% 42%; /* #0E00D6 */\\n  --periwinkle-800: 244 100% 34%; /* #0C00AD */\\n  --periwinkle-900: 244 100% 28%; /* #0A008F */\\n  --periwinkle-950: 244 100% 16%; /* #050052 */\\n\\n  /* Neutral */\\n  --neutral-0: 0 0% 100%; /* #FFFFFF */\\n  --neutral-50: 30 20% 98%; /* #FBFAF9 */\\n  --neutral-100: 20 14% 96%; /* #F6F4F3 */\\n  --neutral-200: 20 13% 91%; /* #EBE7E5 */\\n  --neutral-300: 20 10% 83%; /* #D8D2CF */\\n  --neutral-400: 19 9% 64%; /* #ABA09B */\\n  --neutral-500: 19 8% 48%; /* #847771 */\\n  --neutral-600: 20 9% 38%; /* #6A5E58 */\\n  --neutral-700: 17 9% 29%; /* #514743 */\\n  --neutral-800: 20 12% 20%; /* #39312D */\\n  --neutral-900: 20 13% 13%; /* #26201D */\\n  --neutral-950: 17 17% 8%; /* #181311 */\\n\\n  /* Semantic roles from mobile theme.ts */\\n  --primary: var(--coral-700);\\n  --primary-foreground: 0 0% 100%;\\n  --brand: var(--coral-500);\\n  --success: 160 84% 28%; /* #0B835B */\\n  --warning: 38 92% 33%; /* #A26907 */\\n  --danger: 358 75% 53%; /* #E12D33 */\\n  --info: 213 80% 49%;\\n  --background: var(--cream-50);\\n  --foreground: var(--neutral-900);\\n  --surface: var(--neutral-0);\\n  --ring: var(--coral-600);\\n  --radius: 0.75rem;\\n\\n  /* Spacing scale 4px base */\\n  --space-xs: 0.25rem;\\n  --space-sm: 0.5rem;\\n  --space-md: 0.75rem;\\n  --space-lg: 1rem;\\n  --space-xl: 1.5rem;\\n  --space-xxl: 2rem;\\n  --space-xxxl: 3rem;\\n  --space-xxxxl: 4rem;\\n\\n  /* Border radius scale */\\n  --radius-sm: 0.375rem;\\n  --radius-md: 0.5rem;\\n  --radius-lg: 0.75rem;\\n  --radius-xl: 1rem;\\n  --radius-xxl: 1.5rem;\\n}\\n/* PartyHause Pastel Icon Theme\\n   Icons inherit currentColor and are used with brand pastel tones.\\n   Usage: <Icon className=\\\"icon-pastel-coral\\\" />\\n*/\\n\\n.icon-pastel-coral { color: hsl(var(--coral-500)); }\\n.icon-pastel-coral-soft { color: hsl(var(--coral-300)); }\\n\\n.icon-pastel-magenta { color: hsl(var(--magenta-500)); }\\n.icon-pastel-magenta-soft { color: hsl(var(--magenta-300)); }\\n\\n.icon-pastel-teal { color: hsl(var(--teal-500)); }\\n.icon-pastel-teal-soft { color: hsl(var(--teal-300)); }\\n\\n.icon-pastel-periwinkle { color: hsl(var(--periwinkle-500)); }\\n.icon-pastel-periwinkle-soft { color: hsl(var(--periwinkle-300)); }\\n\\n.icon-pastel-cream { color: hsl(var(--cream-700)); }\\n.icon-pastel-cream-soft { color: hsl(var(--cream-400)); }\\n\\n.icon-pastel-neutral { color: hsl(var(--neutral-700)); }\\n.icon-pastel-neutral-soft { color: hsl(var(--neutral-400)); }\\n\\n/* Pastel fill variants for solid icons */\\n.icon-fill-pastel-coral { fill: hsl(var(--coral-200)); stroke: hsl(var(--coral-600)); }\\n.icon-fill-pastel-magenta { fill: hsl(var(--magenta-200)); stroke: hsl(var(--magenta-600)); }\\n.icon-fill-pastel-teal { fill: hsl(var(--teal-200)); stroke: hsl(var(--teal-600)); }\\n.icon-fill-pastel-periwinkle { fill: hsl(var(--periwinkle-200)); stroke: hsl(var(--periwinkle-600)); }\\n\\n/* Soft background blobs for icon containers */\\n.icon-bg-pastel-coral { background-color: hsl(var(--coral-50)); }\\n.icon-bg-pastel-magenta { background-color: hsl(var(--magenta-50)); }\\n.icon-bg-pastel-teal { background-color: hsl(var(--teal-50)); }\\n.icon-bg-pastel-periwinkle { background-color: hsl(var(--periwinkle-50)); }\\n.icon-bg-pastel-cream { background-color: hsl(var(--cream-100)); }\\n/* Pastel Multicolour Design System\\n   Source: UI DESIGN PROMPT — Pastel Multicolour, Curved Cards & Modern Interface\\n   Primary surfaces: cream and off-white. Accents alternate per card for rhythm.\\n*/\\n\\n:root {\\n  /* Primary pastel accent palette */\\n  --pastel-lavender: #A6A7E8;\\n  --pastel-pink: #F28AA7;\\n  --pastel-peach: #FFA36F;\\n  --pastel-butter: #FFE49A;\\n  --pastel-mint: #A9DCCB;\\n  --pastel-teal: #378F82;\\n\\n  /* Supporting surfaces */\\n  --pastel-bg-pale-pink: #FBE7F7;\\n  --pastel-bg-cream-white: #FFFDF2;\\n  --pastel-bg-light-lavender: #EAE8FF;\\n  --pastel-soft-orange: #F6B347;\\n  --pastel-muted-blue-grey: #858EAC;\\n  --pastel-dark-charcoal: #24252B;\\n\\n  /* Radii */\\n  --radius-card: 32px;\\n  --radius-pill: 9999px;\\n  --radius-soft: 24px;\\n\\n  /* Shadows */\\n  --shadow-soft: 0 8px 24px rgba(36, 37, 43, 0.06);\\n  --shadow-layered: 0 12px 36px rgba(36, 37, 43, 0.08);\\n\\n  /* Spacing rhythm */\\n  --space-card-pad: 1.5rem;\\n}\\n\\n/* Base page background */\\n.pastel-page {\\n  background: var(--pastel-bg-cream-white);\\n  color: var(--pastel-dark-charcoal);\\n  font-family: Inter, Plus Jakarta Sans, Manrope, DM Sans, system-ui, sans-serif;\\n}\\n\\n/* Signature curved card */\\n.pastel-card {\\n  background: #ffffff;\\n  border-radius: var(--radius-card);\\n  padding: var(--space-card-pad);\\n  box-shadow: var(--shadow-soft);\\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\\n}\\n.pastel-card:hover {\\n  transform: translateY(-2px);\\n  box-shadow: var(--shadow-layered);\\n}\\n\\n/* Card colour variants – alternate for rhythm */\\n.pastel-card--lavender { background: linear-gradient(180deg, #ffffff 0%, #F0F0FF 100%); border: 1px solid color-mix(in srgb, var(--pastel-lavender) 20%, transparent); }\\n.pastel-card--pink { background: linear-gradient(180deg, #ffffff 0%, var(--pastel-bg-pale-pink) 100%); border: 1px solid color-mix(in srgb, var(--pastel-pink) 20%, transparent); }\\n.pastel-card--peach { background: linear-gradient(180deg, #ffffff 0%, #FFF0E6 100%); border: 1px solid color-mix(in srgb, var(--pastel-peach) 20%, transparent); }\\n.pastel-card--butter { background: linear-gradient(180deg, #ffffff 0%, #FFF9E0 100%); border: 1px solid color-mix(in srgb, var(--pastel-butter) 20%, transparent); }\\n.pastel-card--mint { background: linear-gradient(180deg, #ffffff 0%, #E8F6F2 100%); border: 1px solid color-mix(in srgb, var(--pastel-mint) 20%, transparent); }\\n.pastel-card--teal { background: linear-gradient(180deg, #ffffff 0%, #E6F2F1 100%); border: 1px solid color-mix(in srgb, var(--pastel-teal) 20%, transparent); }\\n\\n/* Pill buttons */\\n.pastel-pill {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  padding: 0.5rem 1rem;\\n  border-radius: var(--radius-pill);\\n  background: var(--pastel-lavender);\\n  color: white;\\n  font-weight: 600;\\n  box-shadow: var(--shadow-soft);\\n}\\n\\n/* Organic decorative background shape */\\n.pastel-bg-blob {\\n  position: absolute;\\n  inset: auto auto -20% -10%;\\n  width: 60vw;\\n  height: 60vw;\\n  background: radial-gradient(closest-side, color-mix(in srgb, var(--pastel-lavender) 30%, transparent), transparent);\\n  border-radius: 50%;\\n  filter: blur(40px);\\n  pointer-events: none;\\n  z-index: 0;\\n}\\n\\n/* Typography scale */\\n.pastel-h1 { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em; }\\n.pastel-h2 { font-size: 1.75rem; font-weight: 700; }\\n.pastel-body { font-size: 1rem; line-height: 1.6; color: var(--pastel-dark-charcoal); }\\n.pastel-caption { color: var(--pastel-muted-blue-grey); font-size: 0.875rem; }\\n\\n/* Icon container */\\n.pastel-icon-wrap {\\n  width: 48px;\\n  height: 48px;\\n  border-radius: 16px;\\n  display: grid;\\n  place-items: center;\\n  background: color-mix(in srgb, var(--pastel-lavender) 15%, white);\\n}\\n\\n*, ::before, ::after {\\n  --tw-border-spacing-x: 0;\\n  --tw-border-spacing-y: 0;\\n  --tw-translate-x: 0;\\n  --tw-translate-y: 0;\\n  --tw-rotate: 0;\\n  --tw-skew-x: 0;\\n  --tw-skew-y: 0;\\n  --tw-scale-x: 1;\\n  --tw-scale-y: 1;\\n  --tw-pan-x:  ;\\n  --tw-pan-y:  ;\\n  --tw-pinch-zoom:  ;\\n  --tw-scroll-snap-strictness: proximity;\\n  --tw-gradient-from-position:  ;\\n  --tw-gradient-via-position:  ;\\n  --tw-gradient-to-position:  ;\\n  --tw-ordinal:  ;\\n  --tw-slashed-zero:  ;\\n  --tw-numeric-figure:  ;\\n  --tw-numeric-spacing:  ;\\n  --tw-numeric-fraction:  ;\\n  --tw-ring-inset:  ;\\n  --tw-ring-offset-width: 0px;\\n  --tw-ring-offset-color: #fff;\\n  --tw-ring-color: rgb(59 130 246 / 0.5);\\n  --tw-ring-offset-shadow: 0 0 #0000;\\n  --tw-ring-shadow: 0 0 #0000;\\n  --tw-shadow: 0 0 #0000;\\n  --tw-shadow-colored: 0 0 #0000;\\n  --tw-blur:  ;\\n  --tw-brightness:  ;\\n  --tw-contrast:  ;\\n  --tw-grayscale:  ;\\n  --tw-hue-rotate:  ;\\n  --tw-invert:  ;\\n  --tw-saturate:  ;\\n  --tw-sepia:  ;\\n  --tw-drop-shadow:  ;\\n  --tw-backdrop-blur:  ;\\n  --tw-backdrop-brightness:  ;\\n  --tw-backdrop-contrast:  ;\\n  --tw-backdrop-grayscale:  ;\\n  --tw-backdrop-hue-rotate:  ;\\n  --tw-backdrop-invert:  ;\\n  --tw-backdrop-opacity:  ;\\n  --tw-backdrop-saturate:  ;\\n  --tw-backdrop-sepia:  ;\\n  --tw-contain-size:  ;\\n  --tw-contain-layout:  ;\\n  --tw-contain-paint:  ;\\n  --tw-contain-style:  ;\\n}\\n\\n::backdrop {\\n  --tw-border-spacing-x: 0;\\n  --tw-border-spacing-y: 0;\\n  --tw-translate-x: 0;\\n  --tw-translate-y: 0;\\n  --tw-rotate: 0;\\n  --tw-skew-x: 0;\\n  --tw-skew-y: 0;\\n  --tw-scale-x: 1;\\n  --tw-scale-y: 1;\\n  --tw-pan-x:  ;\\n  --tw-pan-y:  ;\\n  --tw-pinch-zoom:  ;\\n  --tw-scroll-snap-strictness: proximity;\\n  --tw-gradient-from-position:  ;\\n  --tw-gradient-via-position:  ;\\n  --tw-gradient-to-position:  ;\\n  --tw-ordinal:  ;\\n  --tw-slashed-zero:  ;\\n  --tw-numeric-figure:  ;\\n  --tw-numeric-spacing:  ;\\n  --tw-numeric-fraction:  ;\\n  --tw-ring-inset:  ;\\n  --tw-ring-offset-width: 0px;\\n  --tw-ring-offset-color: #fff;\\n  --tw-ring-color: rgb(59 130 246 / 0.5);\\n  --tw-ring-offset-shadow: 0 0 #0000;\\n  --tw-ring-shadow: 0 0 #0000;\\n  --tw-shadow: 0 0 #0000;\\n  --tw-shadow-colored: 0 0 #0000;\\n  --tw-blur:  ;\\n  --tw-brightness:  ;\\n  --tw-contrast:  ;\\n  --tw-grayscale:  ;\\n  --tw-hue-rotate:  ;\\n  --tw-invert:  ;\\n  --tw-saturate:  ;\\n  --tw-sepia:  ;\\n  --tw-drop-shadow:  ;\\n  --tw-backdrop-blur:  ;\\n  --tw-backdrop-brightness:  ;\\n  --tw-backdrop-contrast:  ;\\n  --tw-backdrop-grayscale:  ;\\n  --tw-backdrop-hue-rotate:  ;\\n  --tw-backdrop-invert:  ;\\n  --tw-backdrop-opacity:  ;\\n  --tw-backdrop-saturate:  ;\\n  --tw-backdrop-sepia:  ;\\n  --tw-contain-size:  ;\\n  --tw-contain-layout:  ;\\n  --tw-contain-paint:  ;\\n  --tw-contain-style:  ;\\n}\\n\\n/* ! tailwindcss v3.4.17 | MIT License | https://tailwindcss.com\\n*//*\\n1. Prevent padding and border from affecting element width. (https://github.com/mozdevs/cssremedy/issues/4)\\n2. Allow adding a border to an element by just adding a border-width. (https://github.com/tailwindcss/tailwindcss/pull/116)\\n*/\\n\\n*,\\n::before,\\n::after {\\n  box-sizing: border-box; /* 1 */\\n  border-width: 0; /* 2 */\\n  border-style: solid; /* 2 */\\n  border-color: #e5e7eb; /* 2 */\\n}\\n\\n::before,\\n::after {\\n  --tw-content: '';\\n}\\n\\n/*\\n1. Use a consistent sensible line-height in all browsers.\\n2. Prevent adjustments of font size after orientation changes in iOS.\\n3. Use a more readable tab size.\\n4. Use the user's configured `sans` font-family by default.\\n5. Use the user's configured `sans` font-feature-settings by default.\\n6. Use the user's configured `sans` font-variation-settings by default.\\n7. Disable tap highlights on iOS\\n*/\\n\\nhtml,\\n:host {\\n  line-height: 1.5; /* 1 */\\n  -webkit-text-size-adjust: 100%; /* 2 */\\n  -moz-tab-size: 4; /* 3 */\\n  -o-tab-size: 4;\\n     tab-size: 4; /* 3 */\\n  font-family: ui-sans-serif, system-ui, sans-serif, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; /* 4 */\\n  font-feature-settings: normal; /* 5 */\\n  font-variation-settings: normal; /* 6 */\\n  -webkit-tap-highlight-color: transparent; /* 7 */\\n}\\n\\n/*\\n1. Remove the margin in all browsers.\\n2. Inherit line-height from `html` so users can set them as a class directly on the `html` element.\\n*/\\n\\nbody {\\n  margin: 0; /* 1 */\\n  line-height: inherit; /* 2 */\\n}\\n\\n/*\\n1. Add the correct height in Firefox.\\n2. Correct the inheritance of border color in Firefox. (https://bugzilla.mozilla.org/show_bug.cgi?id=190655)\\n3. Ensure horizontal rules are visible by default.\\n*/\\n\\nhr {\\n  height: 0; /* 1 */\\n  color: inherit; /* 2 */\\n  border-top-width: 1px; /* 3 */\\n}\\n\\n/*\\nAdd the correct text decoration in Chrome, Edge, and Safari.\\n*/\\n\\nabbr:where([title]) {\\n  -webkit-text-decoration: underline dotted;\\n          text-decoration: underline dotted;\\n}\\n\\n/*\\nRemove the default font size and weight for headings.\\n*/\\n\\nh1,\\nh2,\\nh3,\\nh4,\\nh5,\\nh6 {\\n  font-size: inherit;\\n  font-weight: inherit;\\n}\\n\\n/*\\nReset links to optimize for opt-in styling instead of opt-out.\\n*/\\n\\na {\\n  color: inherit;\\n  text-decoration: inherit;\\n}\\n\\n/*\\nAdd the correct font weight in Edge and Safari.\\n*/\\n\\nb,\\nstrong {\\n  font-weight: bolder;\\n}\\n\\n/*\\n1. Use the user's configured `mono` font-family by default.\\n2. Use the user's configured `mono` font-feature-settings by default.\\n3. Use the user's configured `mono` font-variation-settings by default.\\n4. Correct the odd `em` font sizing in all browsers.\\n*/\\n\\ncode,\\nkbd,\\nsamp,\\npre {\\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \\\"Liberation Mono\\\", \\\"Courier New\\\", monospace; /* 1 */\\n  font-feature-settings: normal; /* 2 */\\n  font-variation-settings: normal; /* 3 */\\n  font-size: 1em; /* 4 */\\n}\\n\\n/*\\nAdd the correct font size in all browsers.\\n*/\\n\\nsmall {\\n  font-size: 80%;\\n}\\n\\n/*\\nPrevent `sub` and `sup` elements from affecting the line height in all browsers.\\n*/\\n\\nsub,\\nsup {\\n  font-size: 75%;\\n  line-height: 0;\\n  position: relative;\\n  vertical-align: baseline;\\n}\\n\\nsub {\\n  bottom: -0.25em;\\n}\\n\\nsup {\\n  top: -0.5em;\\n}\\n\\n/*\\n1. Remove text indentation from table contents in Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=999088, https://bugs.webkit.org/show_bug.cgi?id=201297)\\n2. Correct table border color inheritance in all Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=935729, https://bugs.webkit.org/show_bug.cgi?id=195016)\\n3. Remove gaps between table borders by default.\\n*/\\n\\ntable {\\n  text-indent: 0; /* 1 */\\n  border-color: inherit; /* 2 */\\n  border-collapse: collapse; /* 3 */\\n}\\n\\n/*\\n1. Change the font styles in all browsers.\\n2. Remove the margin in Firefox and Safari.\\n3. Remove default padding in all browsers.\\n*/\\n\\nbutton,\\ninput,\\noptgroup,\\nselect,\\ntextarea {\\n  font-family: inherit; /* 1 */\\n  font-feature-settings: inherit; /* 1 */\\n  font-variation-settings: inherit; /* 1 */\\n  font-size: 100%; /* 1 */\\n  font-weight: inherit; /* 1 */\\n  line-height: inherit; /* 1 */\\n  letter-spacing: inherit; /* 1 */\\n  color: inherit; /* 1 */\\n  margin: 0; /* 2 */\\n  padding: 0; /* 3 */\\n}\\n\\n/*\\nRemove the inheritance of text transform in Edge and Firefox.\\n*/\\n\\nbutton,\\nselect {\\n  text-transform: none;\\n}\\n\\n/*\\n1. Correct the inability to style clickable types in iOS and Safari.\\n2. Remove default button styles.\\n*/\\n\\nbutton,\\ninput:where([type='button']),\\ninput:where([type='reset']),\\ninput:where([type='submit']) {\\n  -webkit-appearance: button; /* 1 */\\n  background-color: transparent; /* 2 */\\n  background-image: none; /* 2 */\\n}\\n\\n/*\\nUse the modern Firefox focus style for all focusable elements.\\n*/\\n\\n:-moz-focusring {\\n  outline: auto;\\n}\\n\\n/*\\nRemove the additional `:invalid` styles in Firefox. (https://github.com/mozilla/gecko-dev/blob/2f9eacd9d3d995c937b4251a5557d95d494c9be1/layout/style/res/forms.css#L728-L737)\\n*/\\n\\n:-moz-ui-invalid {\\n  box-shadow: none;\\n}\\n\\n/*\\nAdd the correct vertical alignment in Chrome and Firefox.\\n*/\\n\\nprogress {\\n  vertical-align: baseline;\\n}\\n\\n/*\\nCorrect the cursor style of increment and decrement buttons in Safari.\\n*/\\n\\n::-webkit-inner-spin-button,\\n::-webkit-outer-spin-button {\\n  height: auto;\\n}\\n\\n/*\\n1. Correct the odd appearance in Chrome and Safari.\\n2. Correct the outline style in Safari.\\n*/\\n\\n[type='search'] {\\n  -webkit-appearance: textfield; /* 1 */\\n  outline-offset: -2px; /* 2 */\\n}\\n\\n/*\\nRemove the inner padding in Chrome and Safari on macOS.\\n*/\\n\\n::-webkit-search-decoration {\\n  -webkit-appearance: none;\\n}\\n\\n/*\\n1. Correct the inability to style clickable types in iOS and Safari.\\n2. Change font properties to `inherit` in Safari.\\n*/\\n\\n::-webkit-file-upload-button {\\n  -webkit-appearance: button; /* 1 */\\n  font: inherit; /* 2 */\\n}\\n\\n/*\\nAdd the correct display in Chrome and Safari.\\n*/\\n\\nsummary {\\n  display: list-item;\\n}\\n\\n/*\\nRemoves the default spacing and border for appropriate elements.\\n*/\\n\\nblockquote,\\ndl,\\ndd,\\nh1,\\nh2,\\nh3,\\nh4,\\nh5,\\nh6,\\nhr,\\nfigure,\\np,\\npre {\\n  margin: 0;\\n}\\n\\nfieldset {\\n  margin: 0;\\n  padding: 0;\\n}\\n\\nlegend {\\n  padding: 0;\\n}\\n\\nol,\\nul,\\nmenu {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n/*\\nReset default styling for dialogs.\\n*/\\ndialog {\\n  padding: 0;\\n}\\n\\n/*\\nPrevent resizing textareas horizontally by default.\\n*/\\n\\ntextarea {\\n  resize: vertical;\\n}\\n\\n/*\\n1. Reset the default placeholder opacity in Firefox. (https://github.com/tailwindlabs/tailwindcss/issues/3300)\\n2. Set the default placeholder color to the user's configured gray 400 color.\\n*/\\n\\ninput::-moz-placeholder, textarea::-moz-placeholder {\\n  opacity: 1; /* 1 */\\n  color: #9ca3af; /* 2 */\\n}\\n\\ninput::placeholder,\\ntextarea::placeholder {\\n  opacity: 1; /* 1 */\\n  color: #9ca3af; /* 2 */\\n}\\n\\n/*\\nSet the default cursor for buttons.\\n*/\\n\\nbutton,\\n[role=\\\"button\\\"] {\\n  cursor: pointer;\\n}\\n\\n/*\\nMake sure disabled buttons don't get the pointer cursor.\\n*/\\n:disabled {\\n  cursor: default;\\n}\\n\\n/*\\n1. Make replaced elements `display: block` by default. (https://github.com/mozdevs/cssremedy/issues/14)\\n2. Add `vertical-align: middle` to align replaced elements more sensibly by default. (https://github.com/jensimmons/cssremedy/issues/14#issuecomment-634934210)\\n   This can trigger a poorly considered lint error in some tools but is included by design.\\n*/\\n\\nimg,\\nsvg,\\nvideo,\\ncanvas,\\naudio,\\niframe,\\nembed,\\nobject {\\n  display: block; /* 1 */\\n  vertical-align: middle; /* 2 */\\n}\\n\\n/*\\nConstrain images and videos to the parent width and preserve their intrinsic aspect ratio. (https://github.com/mozdevs/cssremedy/issues/14)\\n*/\\n\\nimg,\\nvideo {\\n  max-width: 100%;\\n  height: auto;\\n}\\n\\n/* Make elements with the HTML hidden attribute stay hidden by default */\\n[hidden]:where(:not([hidden=\\\"until-found\\\"])) {\\n  display: none;\\n}\\n  :root {\\n    /* Semantic aliases referencing mobile tokens */\\n    --background: var(--cream-50);\\n    --foreground: var(--neutral-900);\\n    --card: var(--neutral-0);\\n    --card-foreground: var(--neutral-900);\\n    --popover: var(--neutral-0);\\n    --popover-foreground: var(--neutral-900);\\n    --primary: var(--coral-700);\\n    --primary-foreground: 0 0% 100%;\\n    --secondary: var(--cream-100);\\n    --secondary-foreground: var(--neutral-900);\\n    --muted: var(--neutral-100);\\n    --muted-foreground: var(--neutral-600);\\n    --accent: var(--magenta-600);\\n    --accent-foreground: 0 0% 100%;\\n    --destructive: var(--danger);\\n    --destructive-foreground: 0 0% 100%;\\n    --border: var(--neutral-200);\\n    --input: var(--neutral-200);\\n    --ring: var(--coral-600);\\n    --brand: var(--coral-500);\\n    --success: 160 84% 28%;\\n    --warning: 38 92% 33%;\\n    --danger: 358 75% 53%;\\n    --info: 213 80% 49%;\\n    --radius: var(--radius-lg);\\n  }\\n\\n  .dark {\\n    --background: var(--neutral-900);\\n    --foreground: var(--neutral-50);\\n    --card: var(--neutral-800);\\n    --card-foreground: var(--neutral-50);\\n    --popover: var(--neutral-800);\\n    --popover-foreground: var(--neutral-50);\\n    --primary: var(--coral-500);\\n    --primary-foreground: 0 0% 100%;\\n    --secondary: var(--neutral-800);\\n    --secondary-foreground: var(--neutral-50);\\n    --muted: var(--neutral-800);\\n    --muted-foreground: var(--neutral-400);\\n    --accent: var(--magenta-500);\\n    --accent-foreground: 0 0% 100%;\\n    --destructive: var(--danger);\\n    --destructive-foreground: 0 0% 100%;\\n    --border: var(--neutral-700);\\n    --input: var(--neutral-700);\\n    --ring: var(--coral-500);\\n  }\\n  * {\\n    border-color: hsl(var(--border));\\n  }\\n\\n  body {\\n    background-color: hsl(var(--background));\\n    color: hsl(var(--foreground));\\n    font-feature-settings: \\\"rlig\\\" 1, \\\"calt\\\" 1;\\n  }\\n\\n  /* Custom scrollbar - Updated for Light Theme */\\n  ::-webkit-scrollbar {\\n    width: 8px;\\n  }\\n  \\n  ::-webkit-scrollbar-track {\\n    background-color: hsl(var(--muted));\\n  }\\n  \\n  ::-webkit-scrollbar-thumb {\\n    background-color: hsl(var(--primary));\\n    border-radius: 9999px;\\n    box-shadow: var(--shadow-primary);\\n  }\\n\\n  /* High Contrast Mode Support */\\n  @media (prefers-contrast: high) {\\n    :root {\\n      --electric-purple: 270 100% 75%;\\n      --electric-gold: 45 100% 70%;\\n      --bg-cosmic-deep: 220 15% 2%;\\n      --text-cosmic-primary: 0 0% 100%;\\n    }\\n  }\\n\\n  /* Reduced Motion Support */\\n  @media (prefers-reduced-motion: reduce) {\\n    *,\\n    *::before,\\n    *::after {\\n      animation-duration: 0.01ms !important;\\n      animation-iteration-count: 1 !important;\\n      transition-duration: 0.01ms !important;\\n      scroll-behavior: auto !important;\\n    }\\n  }\\n\\n  /* Keyboard-navigation focus: visible ring on :focus-visible only, so\\n     mouse users don't get outlines but keyboard users always do. */\\n  :focus-visible {\\n    outline: 2px solid hsl(var(--ring, 24 95% 53%));\\n    outline-offset: 2px;\\n    border-radius: 4px;\\n  }\\n\\n  :focus:not(:focus-visible) {\\n    outline: none;\\n  }\\n\\n  ::-moz-selection {\\n    background: hsl(var(--primary, 24 95% 53%) / 0.25);\\n  }\\n\\n  ::selection {\\n    background: hsl(var(--primary, 24 95% 53%) / 0.25);\\n  }\\n.container {\\n  width: 100%;\\n  margin-right: auto;\\n  margin-left: auto;\\n  padding-right: 2rem;\\n  padding-left: 2rem;\\n}\\n@media (min-width: 1400px) {\\n\\n  .container {\\n    max-width: 1400px;\\n  }\\n}\\n  /* ============================================ */\\n  /* PHASE 2: LIQUID METAL COMPONENTS            */\\n  /* ============================================ */\\n  \\n  /* ============================================ */\\n  /* 1. LIQUID METAL CARDS                       */\\n  /* ============================================ */\\n  \\n  /* Base Liquid Card */\\n  \\n  /* Card with 3D Effect */\\n  \\n  /* Metallic Card */\\n  \\n  /* ============================================ */\\n  /* 2. METALLIC BUTTONS                         */\\n  /* ============================================ */\\n  \\n  /* Liquid Metal Button */\\n  .btn-liquid-metal {\\n    background: hsl(var(--burnt-orange));\\n    color: white;\\n    font-weight: 700;\\n    padding: 14px 32px;\\n    border-radius: 12px;\\n    border: 1px solid rgba(255, 255, 255, 0.2);\\n    box-shadow: var(--shadow-liquid-md);\\n    transition: all 0.3s var(--ease-liquid);\\n    position: relative;\\n    overflow: hidden;\\n    cursor: pointer;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n  }\\n  \\n  .btn-liquid-metal::before {\\n    content: '';\\n    position: absolute;\\n    top: -50%;\\n    left: -50%;\\n    width: 200%;\\n    height: 200%;\\n    background: rgba(255, 255, 255, 0.2);\\n    transform: rotate(45deg);\\n    transition: all 0.6s;\\n  }\\n  \\n  .btn-liquid-metal:hover::before {\\n    left: 100%;\\n  }\\n  \\n  .btn-liquid-metal:hover {\\n    transform: translateY(-2px);\\n    box-shadow: var(--shadow-liquid-lg);\\n  }\\n  \\n  .btn-liquid-metal:active {\\n    transform: translateY(0);\\n    box-shadow: var(--shadow-liquid-sm);\\n  }\\n  \\n  /* Iridescent Button */\\n  .btn-iridescent {\\n    background: hsl(var(--accent-coral));\\n    color: white;\\n    font-weight: 700;\\n    padding: 14px 32px;\\n    border-radius: 12px;\\n    border: 1px solid rgba(255, 255, 255, 0.2);\\n    box-shadow: var(--shadow-glow-blue);\\n    transition: all 0.3s var(--ease-liquid);\\n    cursor: pointer;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n  }\\n  \\n  .btn-iridescent:hover {\\n    transform: translateY(-3px) scale(1.02);\\n    box-shadow: var(--shadow-glow-purple);\\n  }\\n  \\n  .btn-iridescent:active {\\n    transform: translateY(-1px) scale(1);\\n  }\\n  \\n  /* Glass Button */\\n  .btn-glass {\\n    background: rgba(255, 255, 255, 0.95);\\n    backdrop-filter: blur(20px);\\n    -webkit-backdrop-filter: blur(20px);\\n    color: hsl(var(--burnt-orange));\\n    font-weight: 700;\\n    padding: 14px 32px;\\n    border-radius: 12px;\\n    border: 1px solid rgba(217, 119, 6, 0.3);\\n    box-shadow: var(--shadow-liquid-sm);\\n    transition: all 0.3s var(--ease-fluid);\\n    cursor: pointer;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n  }\\n  \\n  .btn-glass:hover {\\n    background: rgba(255, 255, 255, 1);\\n    border-color: hsl(var(--burnt-orange));\\n    transform: translateY(-2px);\\n    box-shadow: var(--shadow-liquid-md);\\n    color: hsl(var(--accent-orange));\\n  }\\n  \\n  /* ============================================ */\\n  /* 3. 3D ICON BUTTONS                          */\\n  /* ============================================ */\\n  \\n  .icon-btn-liquid {\\n    width: 56px;\\n    height: 56px;\\n    background: hsl(var(--bg-primary));\\n    border-radius: 16px;\\n    border: 1px solid rgba(217, 151, 6, 0.3);\\n    box-shadow: var(--shadow-liquid-md);\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n    transition: all 0.3s var(--ease-liquid);\\n    transform-style: preserve-3d;\\n    perspective: 1000px;\\n    cursor: pointer;\\n    position: relative;\\n    color: hsl(var(--burnt-orange));\\n  }\\n  \\n  .icon-btn-liquid::before {\\n    content: '';\\n    position: absolute;\\n    inset: 0;\\n    border-radius: inherit;\\n    background: rgba(217, 151, 6, 0.2);\\n    opacity: 0;\\n    transition: opacity 0.3s ease;\\n  }\\n  \\n  .icon-btn-liquid:hover {\\n    transform: translateY(-4px) rotateX(8deg) scale(1.05);\\n    box-shadow: var(--shadow-liquid-lg);\\n  }\\n  \\n  .icon-btn-liquid:hover::before {\\n    opacity: 1;\\n  }\\n  \\n  .icon-btn-liquid:active {\\n    transform: translateY(-2px) rotateX(4deg) scale(1.02);\\n  }\\n  \\n  /* Iridescent Icon Button */\\n  \\n  /* ============================================ */\\n  /* 4. GLASS MORPHISM PANELS                    */\\n  /* ============================================ */\\n  \\n  .glass-panel-liquid {\\n    background: rgba(255, 255, 255, 0.6);\\n    backdrop-filter: blur(40px) saturate(180%);\\n    -webkit-backdrop-filter: blur(40px) saturate(180%);\\n    border: 1px solid rgba(255, 255, 255, 0.3);\\n    border-radius: 24px;\\n    box-shadow: var(--shadow-liquid-lg);\\n    position: relative;\\n  }\\n  \\n  .glass-panel-liquid::before {\\n    content: '';\\n    position: absolute;\\n    top: 0;\\n    left: 0;\\n    right: 0;\\n    height: 1px;\\n    background: rgba(217, 151, 6, 0.3);\\n  }\\n  \\n  /* Glass Navigation Bar */\\n  .glass-nav {\\n    background: rgba(255, 255, 255, 0.8);\\n    backdrop-filter: blur(20px) saturate(180%);\\n    -webkit-backdrop-filter: blur(20px) saturate(180%);\\n    border-bottom: 1px solid rgba(0, 0, 0, 0.05);\\n    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);\\n  }\\n  \\n  /* ============================================ */\\n  /* 5. LIQUID METAL INPUTS                      */\\n  /* ============================================ */\\n  \\n  .input-liquid {\\n    background: rgba(255, 255, 255, 0.9);\\n    border: 1px solid hsla(var(--metal-chrome-dark), 0.2);\\n    border-radius: 12px;\\n    padding: 12px 16px;\\n    color: hsl(var(--text-primary));\\n    transition: all 0.3s var(--ease-fluid);\\n    box-shadow: var(--shadow-soft);\\n    position: relative;\\n  }\\n  \\n  .input-liquid:focus {\\n    outline: none;\\n    border-color: hsla(var(--iridescent-blue-start), 0.5);\\n    box-shadow: \\n      0 0 0 4px hsla(var(--iridescent-blue-start), 0.1),\\n      var(--shadow-liquid-sm);\\n    transform: translateY(-1px);\\n  }\\n  \\n  .input-liquid:hover:not(:focus) {\\n    border-color: hsla(var(--metal-chrome-dark), 0.3);\\n    box-shadow: var(--shadow-card);\\n  }\\n  \\n  .input-liquid::-moz-placeholder {\\n    color: hsl(var(--text-muted));\\n  }\\n  \\n  .input-liquid::placeholder {\\n    color: hsl(var(--text-muted));\\n  }\\n  \\n  /* Input with Shimmer Effect */\\n  \\n  /* ============================================ */\\n  /* LEGACY COLOR UTILITIES                      */\\n  /* ============================================ */\\n  \\n  .bg-orange-50 { background-color: hsl(var(--orange-50)); }\\n  .bg-orange-100 { background-color: hsl(var(--orange-100)); }\\n  .bg-orange-200 { background-color: hsl(var(--orange-200)); }\\n  .bg-orange-300 { background-color: hsl(var(--orange-300)); }\\n  .bg-orange-400 { background-color: hsl(var(--orange-400)); }\\n  .bg-orange-500 { background-color: hsl(var(--orange-500)); }\\n  .bg-orange-600 { background-color: hsl(var(--orange-600)); }\\n  \\n  .text-orange-500 { color: hsl(var(--orange-500)); }\\n  .text-orange-600 { color: hsl(var(--orange-600)); }\\n  .text-orange-700 { color: hsl(var(--orange-700)); }\\n  \\n  .border-orange-200 { border-color: hsl(var(--orange-200)); }\\n  .border-orange-300 { border-color: hsl(var(--orange-300)); }\\n  .border-orange-500 { border-color: hsl(var(--orange-500)); }\\n\\n  /* ============================================ */\\n  /* 6. SPECIAL EFFECTS & ENHANCEMENTS           */\\n  /* ============================================ */\\n  \\n  /* Particle Container */\\n  \\n  /* Light Ray Effect */\\n  \\n  /* Liquid Background */\\n  .liquid-bg {\\n    position: fixed;\\n    top: 0;\\n    left: 0;\\n    width: 100%;\\n    height: 100%;\\n    z-index: -1;\\n    background: hsl(var(--bg-soft));\\n  }\\n  \\n  /* Card Shine Effect */\\n  \\n  /* Holographic Border */\\n  \\n  /* Metallic Text */\\n  .text-metallic {\\n    color: hsl(var(--burnt-orange));\\n    font-weight: 600;\\n  }\\n  \\n  /* Status Dot with Pulse */\\n  \\n  @keyframes status-pulse {\\n    0% {\\n      transform: scale(0.95);\\n      box-shadow: 0 0 0 0 currentColor;\\n    }\\n    70% {\\n      transform: scale(1);\\n      box-shadow: 0 0 0 10px transparent;\\n    }\\n    100% {\\n      transform: scale(0.95);\\n      box-shadow: 0 0 0 0 transparent;\\n    }\\n  }\\n  \\n  /* Loading Shimmer */\\n  \\n  @keyframes loading-shimmer {\\n    0% { background-position: -200% 0; }\\n    100% { background-position: 200% 0; }\\n  }\\n  \\n  /* Interactive Ripple Feedback */\\n\\n  /* Hero Section - Soft Clean Design */\\n  \\n  /* Liquid Metal Hero */\\n\\n  /* Video Background Styles */\\n\\n  /* Logo and Typography - Soft Modern */\\n\\n  /* Modern Card Components - Inspired by template */\\n  .modern-card {\\n    background: hsl(var(--bg-primary));\\n    border-radius: 1rem;\\n    box-shadow: var(--shadow-card);\\n    border: 1px solid transparent;\\n    transition: all 0.2s ease;\\n    overflow: hidden;\\n  }\\n\\n  .modern-card:hover {\\n    transform: translateY(-4px);\\n    box-shadow: var(--shadow-elevated);\\n    border-color: hsl(var(--orange-200));\\n  }\\n\\n  .card-elevated {\\n    background: hsl(var(--bg-primary));\\n    border: 1px solid hsl(var(--orange-100));\\n    border-radius: 1rem;\\n    box-shadow: var(--shadow-card);\\n    transition: all 0.2s ease;\\n  }\\n\\n  .card-elevated:hover {\\n    box-shadow: var(--shadow-elevated);\\n    border-color: hsl(var(--orange-300));\\n    transform: translateY(-4px);\\n  }\\n\\n  /* Button Components - Floating Soft Style */\\n  .btn-floating {\\n    background: hsl(var(--orange-500));\\n    color: white;\\n    font-weight: 700;\\n    padding: 0.75rem 2rem;\\n    border-radius: 0.5rem;\\n    border: none;\\n    cursor: pointer;\\n    transition: all 0.2s ease;\\n    box-shadow: var(--shadow-floating);\\n    position: relative;\\n    overflow: hidden;\\n  }\\n\\n  .btn-floating:hover {\\n    transform: translateY(-2px);\\n    box-shadow: var(--shadow-floating-hover);\\n  }\\n\\n  .btn-floating:active {\\n    transform: translateY(0);\\n  }\\n\\n  .btn-soft-secondary {\\n    background: hsl(var(--bg-primary));\\n    color: white;\\n    font-weight: 700;\\n    padding: 0.75rem 2rem;\\n    border: 1px solid hsl(0 0% 90%);\\n    border-radius: 0.5rem;\\n    cursor: pointer;\\n    transition: all 0.2s ease;\\n    box-shadow: var(--shadow-soft);\\n  }\\n\\n  .btn-soft-secondary:hover {\\n    background: hsl(var(--orange-50));\\n    border-color: hsl(var(--orange-300));\\n    box-shadow: var(--shadow-card);\\n  }\\n\\n  /* Icon Button with 3D Effect */\\n  .icon-button-3d {\\n    width: 3.5rem;\\n    height: 3.5rem;\\n    background: hsl(var(--orange-500));\\n    border-radius: 0.75rem;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n    transition: all 0.2s ease;\\n    box-shadow: \\n      0 4px 8px rgba(255, 56, 92, 0.2),\\n      inset 0 1px 0 rgba(255, 255, 255, 0.2);\\n  }\\n\\n  .icon-button-3d:hover {\\n    transform: translateY(-2px);\\n    box-shadow: \\n      0 8px 16px rgba(255, 56, 92, 0.3),\\n      inset 0 1px 0 rgba(255, 255, 255, 0.3);\\n  }\\n\\n  .icon-button-3d:active {\\n    transform: translateY(0);\\n    box-shadow: \\n      0 2px 4px rgba(255, 56, 92, 0.2),\\n      inset 0 1px 0 rgba(255, 255, 255, 0.1);\\n  }\\n\\n  /* Input Components - Soft Style */\\n  .input-soft {\\n    background: hsl(var(--bg-primary));\\n    border: 1px solid hsl(0 0% 90%);\\n    border-radius: 0.5rem;\\n    padding: 0.75rem 1rem;\\n    color: hsl(34 6% 13%);\\n    transition: all 0.2s ease;\\n    box-shadow: var(--shadow-soft);\\n  }\\n\\n  .input-soft:focus {\\n    outline: none;\\n    border-color: hsl(var(--orange-500));\\n    box-shadow: \\n      0 0 0 3px hsl(var(--orange-500) / 0.1),\\n      var(--shadow-card);\\n  }\\n\\n  .input-soft::-moz-placeholder {\\n    color: hsl(var(--text-muted));\\n  }\\n\\n  .input-soft::placeholder {\\n    color: hsl(var(--text-muted));\\n  }\\n\\n  /* Glass Effects */\\n  .glass {\\n    backdrop-filter: blur(20px);\\n    background: hsl(var(--card) / 0.8);\\n    border: 1px solid hsl(var(--border) / 0.5);\\n  }\\n\\n  /* Glow Effects */\\n\\n  /* Party Button Effects (Legacy Compatibility) */\\n  .btn-party {\\n    background: hsl(var(--burnt-orange));\\n    font-weight: 700;\\n    transition: var(--transition-bounce);\\n    box-shadow: var(--shadow-glow);\\n  }\\n\\n  .btn-party:hover {\\n    transform: translateY(-2px) scale(1.02);\\n    box-shadow: 0 0 60px hsl(var(--primary-glow) / 0.5);\\n  }\\n\\n  .btn-party:active {\\n    transform: translateY(0) scale(0.98);\\n  }\\n\\n  /* Card Effects */\\n\\n  /* Loading Effects */\\n\\n  /* QR Code Container */\\n  .qr-container {\\n    background: hsl(var(--bg-dark-elevated));\\n    border: 2px solid hsl(var(--burnt-orange) / 0.3);\\n    box-shadow: var(--shadow-card), var(--shadow-glow);\\n  }\\n\\n  /* Focus Management */\\n\\n  /* Accessibility */\\n  .sr-only {\\n    position: absolute;\\n    width: 1px;\\n    height: 1px;\\n    padding: 0;\\n    margin: -1px;\\n    overflow: hidden;\\n    clip: rect(0, 0, 0, 0);\\n    white-space: nowrap;\\n    border: 0;\\n  }\\n\\n  /* Layout Utilities */\\n\\n  /* Responsive Typography */\\n  \\n  /* ============================================ */\\n  /* 7. DASHBOARD & GRID LAYOUTS                  */\\n  /* ============================================ */\\n  \\n  /* Event Cards Grid */\\n  \\n  /* Event Card Enhanced */\\n  \\n  /* Stats Panel */\\n  .stats-panel {\\n    background: rgba(255, 255, 255, 0.05);\\n    backdrop-filter: blur(20px);\\n    -webkit-backdrop-filter: blur(20px);\\n    border: 1px solid rgba(255, 255, 255, 0.1);\\n    border-radius: 24px;\\n    display: grid;\\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\\n    gap: 1rem;\\n    padding: 1.5rem;\\n  }\\n  \\n  .stat-item {\\n    display: flex;\\n    flex-direction: column;\\n    gap: 0.5rem;\\n    padding: 1rem;\\n    border-radius: 12px;\\n    background: rgba(255, 255, 255, 0.05);\\n    transition: all var(--transition-normal);\\n  }\\n  \\n  .stat-item:hover {\\n    background: rgba(255, 255, 255, 0.1);\\n    transform: translateY(-2px);\\n  }\\n  \\n  .stat-value {\\n    font-size: 2rem;\\n    font-weight: 700;\\n    color: hsl(var(--burnt-orange));\\n  }\\n  \\n  .stat-label {\\n    font-size: 0.875rem;\\n    color: hsl(var(--text-secondary));\\n    text-transform: uppercase;\\n    letter-spacing: 0.05em;\\n  }\\n  \\n 