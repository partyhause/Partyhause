// User profiles (20251101)
model UserProfile {
  id              String  @id // references auth.users(id) ON DELETE CASCADE
  username        String  @unique
  display_name    String
  bio             String?
  avatar_url      String?
  cover_photo_url String?
  location        String?
  website_url     String?

  // Identity: chosen vs assigned handles.
  //
  // `username` keeps the casing the user typed. `username_normalized` is
  // lower(username) and carries the unique index that actually decides
  // identity: the index on `username` above is case-sensitive, so on its own
  // it would let `@Party` and `@party` be two accounts. Harmless while every
  // handle was machine-derived lowercase; an impersonation primitive the
  // moment users pick their own. See server/lib/username.ts.
  username_normalized String @unique

  // B2C identity fields for the about-you step (migration
  // 20261008010000_profile_b2c_fields; file lost from disk, columns live in
  // every database). birth_date is a real calendar date, never the future;
  // interests is the closed taxonomy the onboarding interests screen offers;
  // marketing_opt_in defaults to opted out.
  birth_date       DateTime? @db.Timestamptz
  interests        String[]  @default([])
  marketing_opt_in Boolean   @default(false)

  // Null means the handle is still the u_<base36(uuid)> value signup derived
  // (server/routes/auth.ts:88). Non-null is both "the user chose this" and the
  // start of the 30-day change cooldown, so one column answers both questions.
  username_set_at DateTime?

  // Null means the onboarding picker has never been dismissed. Only consulted
  // when onboarding_required is false; a required picker cannot be skipped.
  onboarding_skipped_at DateTime?

  // False for every profile that existed before the picker shipped: those
  // accounts were never offered a choice, so for them the picker is a
  // dismissible prompt rather than a gate. The migration backfills false and
  // the default is true, so "existing account" needs no date arithmetic and no
  // cutover constant.
  onboarding_required Boolean @default(true)

  // PartyCrew stats (denormalized)
  partycrew_count Int @default(0)
  crewing_count   Int @default(0)
  events_hosted   Int @default(0)
  events_attended Int @default(0)
  haus_score      Int @default(0)

  // Privacy settings
  is_private            Boolean @default(false)
  show_attending_events Boolean @default(true)
  show_partycrew_list   Boolean @default(true)
  show_activity_status  Boolean @default(true)

  // Verification & account type
  is_verified  Boolean @default(false)
  account_type String  @default("personal") // CHECK: IN ('personal', 'business', 'creator')

  // Timestamps
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  last_active_at DateTime @default(now())

  // CHECK: char_length(username) >= 3 AND <= 30
  // CHECK: username ~ '^[a-zA-Z0-9_]+$'
  // CHECK: char_length(username_normalized) >= 3 AND <= 30
  // CHECK: username_normalized ~ '^[a-z0-9_]+$'
  // CHECK: username_normalized = lower(username)

  // Relations — connections (follower/following)
  connections_following        Connection[]         @relation("ConnectionFollower")
  connections_followed         Connection[]         @relation("ConnectionFollowing")
  connection_requests_sent     ConnectionRequest[]  @relation("Requester")
  connection_requests_received ConnectionRequest[]  @relation("Target")
  user_blocks_given            UserBlock[]          @relation("UserBlockBlocker")
  user_blocks_received         UserBlock[]          @relation("UserBlockBlocked")
  posts                        PartycrewPost[]
  post_likes                   PostLike[]
  post_comments                PostComment[]
  post_shares                  PostShare[]
  notifications                Notification[]       @relation("NotificationUser")
  notification_actors          Notification[]       @relation("NotificationActor")
  feed_read_status             FeedReadStatus[]
  content_interactions         ContentInteraction[]
  saved_events                 SavedEvent[]
  username_history             UsernameHistory[]

  @@index([username])
  @@index([display_name])
  @@index([location])
  @@index([haus_score])
  @@index([partycrew_count])
  @@index([last_active_at])
  @@map("user_profiles")
}

/// Every handle a profile has given up, and when.
///
/// WHY THIS TABLE EXISTS
///   The 30-day change cooldown on `user_profiles.username_set_at` protects
///   nothing on its own. A renames away from `@party`; B claims `@party` in the
///   same second; every link, mention and screenshot pointing at A now resolves
///   to B. This table holds a released handle for the same 30 days, against
///   everyone except the account that released it, so the two windows cannot be
///   played against each other.
///
///   It is read on the claim path and on the availability check, so it is a
///   live constraint rather than an audit log that nothing consults.
///
/// RETENTION
///   Rows outlive the hold window on purpose: they are the only record of who
///   held a handle when, which is what an impersonation report needs. They are
///   deleted with the profile (`onDelete: Cascade`), so account deletion stays
///   complete.
model UsernameHistory {
  id                  String   @id @default(dbgenerated("gen_random_uuid()"))
  profile_id          String
  /// The handle as it was stored, original casing preserved.
  username            String
  /// lower(username). The form the hold is matched on.
  username_normalized String
  released_at         DateTime @default(now())

  profile UserProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  /// Covers the hold lookup: normalized form plus recency, in that order.
  @@index([username_normalized, released_at])
  @@index([profile_id])
  @@map("username_history")
}

// Connections / PartyCrew follow relationships (20251101)
