// ============================================================================
// PartyHause Prisma Schema
// ============================================================================
// This file is the single source of truth for the database schema. It is
// applied with `prisma migrate deploy`; prisma/migrations/ holds the history
// and `npm run test:migrations` asserts that replaying it reproduces this file
// exactly. Do not use `prisma db push` against a database that has migrations
// applied: it will reshape tables without recording anything, and the next
// `migrate diff` will report drift it cannot explain.
//
// IMPORTANT NOTES:
// - User foreign keys are plain String columns rather than Prisma relations.
//   Ids are TEXT holding `gen_random_uuid()` output, not the uuid type, so a
//   raw SQL predicate comparing one to a uuid fails with "operator does not
//   exist: text = uuid". See server/sql/azure-pg-functions.sql.
// - Row-level-security policies are NOT declared here and are not created by
//   `prisma db push`. Authorization is enforced in the API; the matrix lives
//   in server/lib/event-access.ts, which is the only thing enforcing it.
// - CHECK constraints written as comments below are documentation, not
//   enforcement, for the same reason. The API validates those vocabularies.
// - Trigger functions (update_updated_at_column, count maintenance) are not
//   emitted by `prisma db push` either; they are applied separately from
//   server/sql/azure-pg-functions.sql.
// - PostgreSQL CHECK constraints are documented in comments since Prisma
//   does not support CHECK constraints directly.
// - Database RPC functions are documented at the bottom of this file.
// - The `partyboard_tasks`, `budget_items`, and `ai_extractions` tables
//   were mentioned in prior analysis but do NOT exist as actual tables in
//   any migration file. `partyboard_tasks` and `budget_items` exist only as
//   JSONB data inside `templates.default_payload`. `ai_extractions` was
//   never created. They are therefore omitted from this schema.
// - The `email_analytics` view is omitted (Prisma does not manage views).
// - POINT columns (location_coordinates) use Unsupported("point").
// ============================================================================

// NOTE: In Prisma 7, the `url` property is no longer supported in the
// datasource block. The connection URL is configured in prisma.config.ts
// and passed via the DATABASE_URL environment variable. See
// prisma.config.ts for the Migrate connection configuration.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum TemplateCategory {
  birthday
  wedding
  corporate
  holiday
  social
  sports
  cultural
  fundraiser
  other
}

enum PriceTier {
  free
  basic
  premium
}

// ============================================================================
// LEGACY TABLES
// ============================================================================

// Users table. Holds credentials and the verification/reset token state for
// the self-hosted JWT auth in server/routes/auth.ts. password_hash is nullable
// so an SSO row can exist without one; login refuses those rather than
// comparing against null.
model User {
  id                         String    @id @default(dbgenerated("gen_random_uuid()"))
  email                      String    @unique
  name                       String?
  password_hash              String?
  reset_token                String?   @unique
  reset_token_expires        DateTime?
  email_verified             Boolean   @default(false)
  verification_token         String?   @unique
  verification_token_expires DateTime?
  token_version              Int       @default(0)
  account_status             String    @default("active")
  terms_version              String?
  privacy_version            String?
  age_eligible               Boolean   @default(false)
  deletion_requested_at      DateTime?
  stripe_customer_id         String?   @unique

  // Account role and card verification (migration 20261008000000
  // _account_role_and_card_verification; file lost from disk, columns live in
  // every database). account_role is the vendor-side role, distinct from
  // user_profiles.account_type; the API route for it was removed (server/
  // routes/users.ts), so nothing writes it yet.
  // CHECK: IN ('creator', 'vendor', 'attendee')
  account_role     String?
  card_verified_at DateTime? @db.Timestamptz

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Relations
  events                  Event[]                @relation("UserHostedEvents")
  event_co_hosts          EventCoHost[]
  media                   Media[]
  activity_participants   ActivityParticipant[]
  vendor_tasks            VendorTask[]           @relation("VendorTaskAssignee")
  invite_templates        InviteTemplate[]
  templates               Template[]             @relation("TemplateAuthor")
  template_usage          TemplateUsage[]
  event_invite_tokens     EventInviteToken[]     @relation("TokenCreator")
  cost_split_requests     CostSplitRequest[]     @relation("CostSplitCreator")
  guest_crew_conversions  GuestCrewConversion[]  @relation("ConversionUser")
  guest_crew_conversions2 GuestCrewConversion[]  @relation("ConversionByUser")
  polls                   Poll[]
  poll_votes              PollVote[]
  partyboard_stickies     PartyBoardSticky[]     @relation("PartyBoardStickyCreator")
  partyboard_sticky_votes PartyBoardStickyVote[] @relation("PartyBoardStickyVoter")
  partyboard_tasks        PartyBoardTask[]       @relation("PartyBoardTaskCreator")
  mvp_commands            MvpCommand[]           @relation("MvpCommandActor")
  attendance_audits       AttendanceAudit[]      @relation("AttendanceAuditActor")
  subscription            Subscription?
  ai_usage                AiUsage[]
  onboarding_response     OnboardingResponse?
  vendor_profile          VendorProfile?
  vendor_application      VendorApplication?
  ticket_sales            TicketSale[]

  @@map("users")
}

// Legacy games table
model Game {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id    String
  type        String
  settings    Json     @default("{}")
  content     Json     @default("{}")
  order_index Int
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  // Relations
  event             Event         @relation(fields: [event_id], references: [id])
  game_sessions     GameSession[]
  active_for_events Event[]       @relation("EventActiveGame")

  @@index([event_id])
  @@map("games")
}

// Legacy game sessions table
model GameSession {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  game_id       String
  status        String   @default("pending")
  current_round Int      @default(0)
  scores        Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  // Relations
  game Game @relation(fields: [game_id], references: [id])

  @@index([game_id])
  @@map("game_sessions")
}

// ============================================================================
// CORE EVENT MANAGEMENT
// ============================================================================

// Events table — built up across many migrations. Contains columns from the
// initial schema (20250908), multi-day support (20250916), description
// (20250917), template system (20251022), and template data (20251109).
model Event {
  id                   String    @id @default(dbgenerated("gen_random_uuid()"))
  host_id              String // references auth.users(id) ON DELETE CASCADE
  name                 String
  event_date           DateTime? // Legacy field — use start_date for new events
  location             String
  spotify_playlist_url String?
  active_game_id       String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @default(now()) @updatedAt

  // Multi-day support (20250916)
  start_date DateTime
  end_date   DateTime
  event_type String   @default("single_day") // CHECK: IN ('single_day', 'multi_day')
  // CHECK: end_date >= start_date (constraint check_end_date_after_start_date)

  // Invite image / capacity (20250915, 20250918)
  invite_image_url String?
  max_guests       Int     @default(50)
  is_public        Boolean @default(false)

  // Description (20250917)
  description String?

  // Template system columns (20251022, 20251108, 20251109)
  template_type        String? // VARCHAR(100) — event template identifier
  title                String? // VARCHAR(255)
  timezone             String?               @default("UTC") // VARCHAR(50)
  location_name        String? // VARCHAR(255)
  location_address     String?
  location_coordinates Unsupported("point")?
  privacy              String                @default("private") // CHECK: IN ('public', 'private', 'unlisted')
  status               String                @default("draft") // CHECK: IN ('draft', 'published', 'active', 'completed', 'cancelled', 'archived')
  settings             Json                  @default("{}")
  template_data        Json                  @default("{}")
  timeline_blocks      Json                  @default("[]")
  revision             Int                   @default(1)
  published_at         DateTime?
  cancelled_at         DateTime?
  completed_at         DateTime?

  // External event source (migration 20261009000000_add_external_event_source;
  // file lost from disk, columns live in every database). place_id links an
  // event to a geo_places row; external_source + external_event_id carry a
  // provider identity with a UNIQUE index over both WHERE both NOT NULL — a
  // partial index Prisma cannot express, so it lives in the database only and
  // must never be dropped.
  external_event_id  String? @db.VarChar(255)
  external_source   String?
  external_metadata Json?
  place_id          String?

  // Relations
  host                   User                  @relation("UserHostedEvents", fields: [host_id], references: [id])
  active_game            Game?                 @relation("EventActiveGame", fields: [active_game_id], references: [id])
  place                  GeoPlace?             @relation("EventPlace", fields: [place_id], references: [id])
  guests                 Guest[]
  games                  Game[]
  email_logs             EmailLog[]
  event_co_hosts         EventCoHost[]
  tickets                Ticket[]
  timeline_blocks_rel    TimelineBlock[]
  media                  Media[]
  activities             Activity[]
  vendors                Vendor[]
  template_usage         TemplateUsage[]
  partycrew_posts        PartycrewPost[]
  notifications          Notification[]
  event_invite_tokens    EventInviteToken[]
  cost_split_requests    CostSplitRequest[]
  guest_crew_conversions GuestCrewConversion[]
  event_cost_summary     EventCostSummary?
  polls                  Poll[]
  partyboard_stickies    PartyBoardSticky[]
  partyboard_tasks       PartyBoardTask[]
  saved_events           SavedEvent[]
  guest_invitations      GuestInvitation[]
  invitation_deliveries  InvitationDelivery[]
  attendance_audits      AttendanceAudit[]
  ticket_holds           TicketHold[]          @relation("TicketHoldEvent")
  ticket_sales           TicketSale[]          @relation("TicketSaleEvent")

  @@index([host_id])
  @@index([status])
  @@index([start_date, end_date])
  @@index([template_type])
  @@index([privacy])
  @@index([place_id])
  @@map("events")
}

// Event co-hosts (20251022, 20260619)
model EventCoHost {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id    String
  user_id     String // references auth.users(id) ON DELETE CASCADE
  role        String   @default("co-host") // VARCHAR(50)
  permissions Json     @default("{\"can_edit\": true, \"can_invite\": true, \"can_moderate\": true}")
  created_at  DateTime @default(now())

  // Relations
  event Event @relation(fields: [event_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
  @@map("event_co_hosts")
}

// Guests table — built up across initial schema, email tracking, template
// phase 1, and guest/crew features migrations.
model Guest {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  event_id          String
  name              String // VARCHAR(255) NOT NULL
  email             String // NOT NULL
  normalized_email  String    @default("")
  revision          Int       @default(1)
  rsvp_responded_at DateTime?
  is_checked_in     Boolean   @default(false) // Legacy column from initial schema
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  // Email tracking (20250914)
  email_status       String?   @default("not_sent") // CHECK: IN ('not_sent', 'sent', 'delivered', 'opened', 'clicked', 'bounced', 'failed')
  last_email_sent_at DateTime?
  email_log_id       String? // references email_logs(id)

  // Template phase 1 (20251022)
  phone                String? // VARCHAR(50)
  rsvp_status          String    @default("pending") // CHECK: IN ('pending', 'accepted', 'declined', 'maybe')
  ticket_type          String? // VARCHAR(100)
  ticket_id            String? // VARCHAR(100)
  qr_code              String?
  plus_ones            Int       @default(0)
  dietary_restrictions String[]
  custom_fields        Json      @default("{}")
  checked_in           Boolean   @default(false)
  checked_in_at        DateTime?
  role                 String    @default("guest") // CHECK: IN ('host', 'co-host', 'guest', 'vendor', 'volunteer')
  metadata             Json      @default("{}")

  // Guest/crew features (20251103)
  user_id            String? // references auth.users(id) ON DELETE SET NULL
  cost_share_enabled Boolean  @default(false)
  cost_share_amount  Decimal? @db.Decimal(10, 2)
  payment_status     String   @default("unpaid") // CHECK: IN ('unpaid', 'paid', 'refunded', 'partial')
  payment_intent_id  String?

  // Relations
  event                  Event                 @relation(fields: [event_id], references: [id])
  email_log              EmailLog?             @relation("GuestEmailLog", fields: [email_log_id], references: [id])
  email_logs             EmailLog[]            @relation("GuestEmailLogs")
  cost_split_requests    CostSplitRequest[]
  guest_crew_conversions GuestCrewConversion[]
  guest_invitation       GuestInvitation?
  invitation_deliveries  InvitationDelivery[]
  attendance_audits      AttendanceAudit[]
  ticket_sales           TicketSale[]

  @@unique([event_id, normalized_email])
  // One account can hold at most one guest seat per event. PostgreSQL treats
  // NULLs as distinct in a unique index, so the many un-bound guests an event
  // has before anyone responds are unaffected; only claimed seats collide.
  // This is what stops a second RSVP claim from silently creating a duplicate
  // attendee for the same person.
  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([rsvp_status])
  @@index([email])
  @@index([checked_in])
  @@index([user_id])
  @@index([event_id, rsvp_status])
  @@index([event_id, payment_status])
  @@index([user_id, event_id])
  @@map("guests")
}

// Tickets (20251022)
model Ticket {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id    String
  type        String // VARCHAR(50) NOT NULL
  name        String // VARCHAR(255) NOT NULL
  description String?
  price       Decimal  @default(0) @db.Decimal(10, 2)
  currency    String   @default("USD") // VARCHAR(3)
  quantity    Int // NOT NULL
  sold        Int      @default(0)
  settings    Json     @default("{}")
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  // CHECK: sold <= quantity

  // Relations
  event Event        @relation(fields: [event_id], references: [id])
  holds TicketHold[] @relation("TicketHoldTicket")
  sales TicketSale[] @relation("TicketSaleTicket")

  @@index([event_id])
  @@index([type])
  @@map("tickets")
}

// Timeline blocks (20251022)
model TimelineBlock {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id      String
  label         String // VARCHAR(255) NOT NULL
  description   String?
  start_time    DateTime
  duration      Int // minutes — NOT NULL
  type          String // CHECK: IN ('activity', 'meal', 'speech', 'performance', 'break', 'custom')
  host_notes    String?
  guest_visible Boolean  @default(true)
  notify_before Int? // minutes before to send reminder
  location      String? // VARCHAR(255)
  assigned_to   String[]
  order_index   Int
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  // Relations
  event Event @relation(fields: [event_id], references: [id])

  @@index([event_id])
  @@index([start_time])
  @@index([event_id, order_index])
  @@map("timeline_blocks")
}

// Media (20251022)
model Media {
  id                   String                @id @default(dbgenerated("gen_random_uuid()"))
  event_id             String
  uploader_id          String // references auth.users(id) ON DELETE CASCADE
  type                 String // CHECK: IN ('photo', 'video')
  url                  String
  thumbnail_url        String?
  width                Int?
  height               Int?
  duration             Int? // for videos in seconds
  file_size            BigInt?
  mime_type            String? // VARCHAR(100)
  tags                 String[]
  location_coordinates Unsupported("point")?
  captured_at          DateTime?
  uploaded_at          DateTime              @default(now())
  status               String                @default("pending") // CHECK: IN ('pending', 'approved', 'rejected', 'flagged')
  moderation_notes     String?
  credits              String? // VARCHAR(255)
  created_at           DateTime              @default(now())

  // Relations
  event    Event @relation(fields: [event_id], references: [id])
  uploader User  @relation(fields: [uploader_id], references: [id])

  @@index([event_id])
  @@index([uploader_id])
  @@index([status])
  @@index([captured_at])
  @@index([type])
  @@map("media")
}

// Activities (20251022)
model Activity {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  event_id    String
  type        String // CHECK: IN ('poll', 'trivia', 'scavenger', 'vote', 'quiz')
  title       String // VARCHAR(255) NOT NULL
  description String?
  status      String    @default("draft") // CHECK: IN ('draft', 'active', 'paused', 'completed')
  start_time  DateTime?
  end_time    DateTime?
  duration    Int? // minutes
  config      Json      @default("{}")
  results     Json      @default("{}")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt

  // Relations
  event        Event                 @relation(fields: [event_id], references: [id])
  participants ActivityParticipant[]

  @@index([event_id])
  @@index([status])
  @@index([type])
  @@map("activities")
}

// Activity participants (20251022)
model ActivityParticipant {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  activity_id String
  user_id     String // references auth.users(id) ON DELETE CASCADE
  score       Int      @default(0)
  completed   Boolean  @default(false)
  responses   Json     @default("{}")
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  // Relations
  activity Activity @relation(fields: [activity_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])

  @@unique([activity_id, user_id])
  @@index([activity_id])
  @@index([user_id])
  @@map("activity_participants")
}

// Vendors (20251022)
model Vendor {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id        String
  name            String // VARCHAR(255) NOT NULL
  role            String // VARCHAR(100) NOT NULL
  contact_email   String? // VARCHAR(255)
  contact_phone   String? // VARCHAR(50)
  contact_website String?
  contract_url    String?
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  // Relations
  event Event        @relation(fields: [event_id], references: [id])
  tasks VendorTask[]

  @@index([event_id])
  @@map("vendors")
}

// Vendor tasks (20251022)
model VendorTask {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  vendor_id    String
  description  String
  due_date     DateTime?
  completed    Boolean   @default(false)
  completed_at DateTime?
  assigned_to  String? // references auth.users(id) — no ON DELETE clause
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  // Relations
  vendor   Vendor @relation(fields: [vendor_id], references: [id])
  assignee User?  @relation("VendorTaskAssignee", fields: [assigned_to], references: [id])

  @@index([vendor_id])
  @@index([due_date])
  @@index([completed])
  @@map("vendor_tasks")
}

// ============================================================================
// VENDOR MARKETPLACE (migration 20261007075636_vendor_marketplace; file lost
// from disk, tables live in every database. Distinct from the per-event
// Vendor/VendorTask pair above: these are the platform-side vendor identity,
// catalogue and application-review tables. No API routes read them yet.)
// ============================================================================

/// A vendor's platform-wide business identity. One per user.
model VendorProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()"))
  user_id           String   @unique
  business_name     String
  legal_name        String?
  tax_id            String?
  role              String
  description       String?
  website           String?
  phone             String?
  email             String
  logo_url          String?
  cover_url         String?
  location_city     String?
  location_region   String?
  location_country  String?
  service_radius_km Int?
  rating_avg        Decimal? @db.Decimal(3, 2)
  rating_count      Int      @default(0)
  is_verified       Boolean  @default(false)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user     User            @relation(fields: [user_id], references: [id])
  services VendorService[]

  @@index([role])
  @@index([location_country, location_region])
  @@map("vendor_profiles")
}

/// A service a vendor offers, with a price band. Catalogue, not booking.
model VendorService {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  vendor_id    String
  name         String
  description  String?
  price_min    Decimal? @db.Decimal(10, 2)
  price_max    Decimal? @db.Decimal(10, 2)
  currency     String   @default("GBP")
  duration_min Int?
  tags         String[]
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id])
  @@map("vendor_services")
}

/// A user's application to become a vendor. One per user, reviewed by an admin.
model VendorApplication {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  user_id      String    @unique
  status       String    @default("pending") // CHECK: IN ('pending', 'approved', 'rejected')
  submitted_at DateTime  @default(now())
  reviewed_at  DateTime?
  notes        String?
  reviewer_id  String?

  user User @relation(fields: [user_id], references: [id])

  @@map("vendor_applications")
}

/// A named place with a PostGIS point, for external event source matching.
/// `coordinates` is read-only to Prisma: Unsupported columns cannot be
/// written, and no code writes this table yet.
model GeoPlace {
  id          String                   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  address     String?
  city        String?
  region      String?
  country     String?
  coordinates Unsupported("geometry")?
  created_at  DateTime                 @default(now())

  events Event[] @relation("EventPlace")

  @@index([city, region])
  @@map("geo_places")
}

// ============================================================================
// TICKETING LEDGER (migration 20261008000000_location_ticketing; file lost
// from disk, tables live in every database. Holds are the reservation half,
// sales the completed-purchase half. No API routes read either yet; the
// existing Ticket model above is the inventory.)
// ============================================================================

/// A session-scoped reservation of tickets, expiring if unpaid.
model TicketHold {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id   String
  ticket_id  String
  session_id String
  quantity   Int
  expires_at DateTime
  created_at DateTime @default(now())

  event  Event  @relation("TicketHoldEvent", fields: [event_id], references: [id], onDelete: Cascade)
  ticket Ticket @relation("TicketHoldTicket", fields: [ticket_id], references: [id], onDelete: Cascade)

  @@unique([event_id, ticket_id, session_id])
  @@index([event_id, ticket_id])
  @@index([expires_at])
  @@map("ticket_holds")
}

/// A completed ticket purchase, against a user or an invited guest.
model TicketSale {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  event_id       String
  ticket_id      String?
  user_id        String?
  guest_id       String?
  quantity       Int       @default(1)
  unit_price     Decimal   @db.Decimal(10, 2)
  currency       String    @default("USD")
  status         String    @default("paid")
  payment_method String?
  payment_intent String?   @unique
  reference      String?   @unique
  purchased_at   DateTime  @default(now())
  expires_at     DateTime?
  metadata       Json      @default("{}")

  event Event @relation("TicketSaleEvent", fields: [event_id], references: [id], onDelete: Cascade)

  ticket Ticket? @relation("TicketSaleTicket", fields: [ticket_id], references: [id])
  user   User?   @relation(fields: [user_id], references: [id])
  guest  Guest?  @relation(fields: [guest_id], references: [id])

  @@index([event_id, status])
  @@index([user_id, status])
  @@index([purchased_at])
  @@map("ticket_sales")
}

// ============================================================================
// EMAIL SYSTEM
// ============================================================================

// Email logs (20250914, 20251010)
model EmailLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  event_id        String? // references events(id) ON DELETE CASCADE
  guest_id        String? // references guests(id) ON DELETE CASCADE
  resend_email_id String?
  email_type      String // CHECK: IN ('invitation', 'confirmation', 'reminder', 'test')
  recipient_email String
  subject         String
