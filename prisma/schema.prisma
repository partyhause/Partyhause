// ============================================================================
// PARTYBOARD: collaborative planning canvas
// ============================================================================
//
// The web canvas (src/features/partyboard, 1,320 lines) shipped against
// /api/partyboard/stickies, which was never written. Every fetch 404'd, so
// every sticky a user dragged onto the board vanished on the next poll. These
// three tables are that endpoint's storage.
//
// Votes are a table rather than a counter column because the canvas renders
// `user_has_voted` per viewer. A counter cannot answer "did I vote", and the
// unique constraint below is what makes a second click idempotent instead of
// a second vote.

model PartyBoardSticky {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id   String
  session_id String? // optional brainstorm session grouping
  type       String // CHECK: IN ('note', 'idea'), the two the canvas creates
  position_x Int      @default(0)
  position_y Int      @default(0)
  width      Int      @default(200)
  height     Int      @default(200)
  rotation   Int?
  z_index    Int      @default(0)
  category   String? // CHECK: IN ('venue','entertainment','food','activities','decor','other')
  data       Json     @default("{}") // NoteStickyData | IdeaStickyData
  created_by String // references users(id)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Relations
  event   Event                  @relation(fields: [event_id], references: [id])
  creator User                   @relation("PartyBoardStickyCreator", fields: [created_by], references: [id])
  votes   PartyBoardStickyVote[]
  task    PartyBoardTask?

  @@index([event_id])
  @@index([event_id, session_id])
  @@index([created_by])
  @@map("partyboard_stickies")
}

model PartyBoardStickyVote {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  sticky_id  String
  user_id    String // references users(id)
  created_at DateTime @default(now())

  // Relations
  sticky PartyBoardSticky @relation(fields: [sticky_id], references: [id])
  user   User             @relation("PartyBoardStickyVoter", fields: [user_id], references: [id])

  @@unique([sticky_id, user_id])
  @@index([sticky_id])
  @@index([user_id])
  @@map("partyboard_sticky_votes")
}

// An idea promoted to committed work. One per sticky, enforced by the unique
// sticky_id, so "convert to task" is idempotent rather than a duplicate factory.
model PartyBoardTask {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  event_id       String
  sticky_id      String    @unique
  title          String
  estimated_cost Decimal?  @db.Decimal(10, 2)
  status         String    @default("open") // CHECK: IN ('open', 'done')
  created_by     String // references users(id)
  created_at     DateTime  @default(now())
  completed_at   DateTime?

  // Relations
  event   Event            @relation(fields: [event_id], references: [id])
  sticky  PartyBoardSticky @relation(fields: [sticky_id], references: [id])
  creator User             @relation("PartyBoardTaskCreator", fields: [created_by], references: [id])

  @@index([event_id])
  @@index([status])
  @@map("partyboard_tasks")
}

// ============================================================================
// GUEST-TO-CREW FEATURES (20251103)
// ============================================================================

// Event invite tokens (for QR codes and shareable links)
model EventInviteToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  event_id         String
  token            String    @unique
  token_type       String // CHECK: IN ('guest_join', 'crew_invite', 'guest_and_crew')
  max_uses         Int? // CHECK: max_uses IS NULL OR max_uses > 0
  current_uses     Int       @default(0)
  expires_at       DateTime?
  created_by       String // references auth.users(id)
  created_at       DateTime  @default(now())
  last_used_at     DateTime?
  is_active        Boolean   @default(true)
  allowed_emails   String[] // Whitelist of emails (null = anyone)
  require_approval Boolean   @default(false)
  uses_log         Json      @default("[]") // Array of { user_id, timestamp, ip }
  // CHECK: current_uses <= COALESCE(max_uses, current_uses)

  // Relations
  event   Event @relation(fields: [event_id], references: [id])
  creator User  @relation("TokenCreator", fields: [created_by], references: [id])

  @@index([event_id])
  @@map("event_invite_tokens")
}

// Cost split requests (tracks individual payments)
model CostSplitRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()"))
  event_id            String
  guest_id            String
  amount              Decimal   @db.Decimal(10, 2) // CHECK: amount > 0
  currency            String    @default("USD")
  description         String?
  status              String    @default("pending") // CHECK: IN ('pending', 'sent', 'paid', 'overdue', 'cancelled', 'refunded')
  payment_method      String?
  payment_reference   String?
  paid_at             DateTime?
  reminder_sent_count Int       @default(0)
  last_reminder_at    DateTime?
  created_by          String // references auth.users(id)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt
  due_date            DateTime?
  admin_notes         String?
  guest_notes         String?

  // Relations
  event   Event @relation(fields: [event_id], references: [id])
  guest   Guest @relation(fields: [guest_id], references: [id])
  creator User  @relation("CostSplitCreator", fields: [created_by], references: [id])

  @@index([event_id])
  @@index([guest_id])
  @@index([status])
  @@map("cost_split_requests")
}

// Guest-to-crew conversions (audit trail)
model GuestCrewConversion {
  id                String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id          String
  guest_id          String
  user_id           String // references auth.users(id) ON DELETE CASCADE
  converted_by      String // references auth.users(id)
  conversion_type   String // CHECK: IN ('host_promoted', 'guest_accepted', 'auto_mutual')
  connection_id     String? // references connections(id) ON DELETE SET NULL
  connection_status String? // CHECK: IN ('pending', 'accepted', 'declined')
  created_at        DateTime @default(now())

  // Relations
  event             Event       @relation(fields: [event_id], references: [id])
  guest             Guest       @relation(fields: [guest_id], references: [id])
  user              User        @relation("ConversionUser", fields: [user_id], references: [id])
  converted_by_user User        @relation("ConversionByUser", fields: [converted_by], references: [id])
  connection        Connection? @relation(fields: [connection_id], references: [id])

  @@unique([guest_id, user_id])
  @@index([event_id])
  @@index([guest_id])
  @@index([user_id])
  @@map("guest_crew_conversions")
}

// Event cost split summary (denormalized, one row per event)
model EventCostSummary {
  event_id           String   @id // references events(id) ON DELETE CASCADE
  total_event_cost   Decimal  @default(0) @db.Decimal(10, 2)
  total_collected    Decimal  @default(0) @db.Decimal(10, 2)
  total_pending      Decimal  @default(0) @db.Decimal(10, 2)
  total_overdue      Decimal  @default(0) @db.Decimal(10, 2)
  guests_with_splits Int      @default(0)
  guests_paid        Int      @default(0)
  guests_pending     Int      @default(0)
  split_enabled      Boolean  @default(false)
  split_method       String? // CHECK: IN ('equal', 'custom', 'percentage')
  currency           String?  @default("USD")
  updated_at         DateTime @default(now()) @updatedAt

  // Relations
  event Event @relation(fields: [event_id], references: [id])

  @@map("event_cost_summaries")
}

// Idempotency record for retryable IOS-MVP commands.
model MvpCommand {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  actor_id        String
  idempotency_key String
  operation       String
  request_hash    String
  status          String   @default("pending")
  request_payload Json?
  response        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt
  expires_at      DateTime

  actor                 User                 @relation("MvpCommandActor", fields: [actor_id], references: [id], onDelete: Cascade)
  attendance_audit      AttendanceAudit?
  invitation_deliveries InvitationDelivery[] @relation("InvitationDeliveryCommand")

  @@unique([actor_id, idempotency_key])
  @@index([status, expires_at])
  @@index([actor_id, operation, created_at])
  @@map("mvp_commands")
}

// One hashed browser RSVP credential per guest.
model GuestInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  guest_id   String    @unique
  event_id   String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt

  // Anonymous RSVP is the default contract, not a legacy one. The migration
  // added this column with DEFAULT false, so every invitation that already
  // existed was grandfathered to anonymous in one atomic statement and keeps
  // answering without a session until expires_at passes, the contract it was
  // sent under. The default stays false while the app is iPhone-only; the
  // doc comment on the field gives the reasoning and the one ALTER that
  // flips it.
  /// Per invitation, defaulting to false while the app is iPhone-only.
  ///
  /// An account-required invitation is one an Android guest can never answer,
  /// because there is no Android build at 1.0
  /// (docs/mobile-ios-launch/07-ios-app-store-launch-requirements.md:82 names
  /// an Android launch a submission blocker). A host who wants an
  /// account-gated event sets this per event. Flip the default once Android
  /// ships; it is one ALTER.
  requires_account Boolean @default(false)

  guest      Guest                @relation(fields: [guest_id], references: [id], onDelete: Cascade)
  event      Event                @relation(fields: [event_id], references: [id], onDelete: Cascade)
  deliveries InvitationDelivery[]

  @@index([event_id])
  @@index([expires_at])
  @@index([revoked_at])
  @@map("guest_invitations")
}

// Provider-owned delivery evidence for one guest invitation.
model InvitationDelivery {
  id                    String    @id @default(dbgenerated("gen_random_uuid()"))
  command_id            String
  invitation_id         String
  event_id              String
  guest_id              String
  status                String    @default("queued")
  provider              String
  provider_message_id   String?
  attempt_count         Int       @default(0)
  error_code            String?
  processing_started_at DateTime?
  lease_expires_at      DateTime?
  lease_token           String?
  accepted_at           DateTime?
  delivered_at          DateTime?
  bounced_at            DateTime?
  failed_at             DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt

  invitation GuestInvitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)
  event      Event           @relation(fields: [event_id], references: [id], onDelete: Cascade)
  guest      Guest           @relation(fields: [guest_id], references: [id], onDelete: Cascade)
  command    MvpCommand      @relation("InvitationDeliveryCommand", fields: [command_id], references: [id], onDelete: Cascade)

  @@unique([command_id, guest_id])
  @@index([invitation_id])
  @@index([event_id, status])
  @@index([guest_id, created_at])
  @@index([status, lease_expires_at])
  @@index([provider, provider_message_id])
  @@map("invitation_deliveries")
}

// Immutable evidence for check-in and explicit attendance corrections.
model AttendanceAudit {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  event_id       String
  guest_id       String
  actor_id       String
  command_id     String   @unique
  action         String
  prior_state    Boolean
  new_state      Boolean
  guest_revision Int
  occurred_at    DateTime @default(now())

  event   Event      @relation(fields: [event_id], references: [id], onDelete: Cascade)
  guest   Guest      @relation(fields: [guest_id], references: [id], onDelete: Cascade)
  actor   User       @relation("AttendanceAuditActor", fields: [actor_id], references: [id], onDelete: Cascade)
  command MvpCommand @relation(fields: [command_id], references: [id], onDelete: Cascade)

  @@index([event_id, occurred_at])
  @@index([guest_id, occurred_at])
  @@index([actor_id, occurred_at])
  @@map("attendance_audits")
}

// Nonidentifying deletion receipt. user_id deliberately has no User relation.
model AccountDeletionRequest {
  id                      String    @id @default(dbgenerated("gen_random_uuid()"))
  user_id                 String?   @unique
  subject_hash            String?   @unique
  status                  String    @default("pending")
  requested_at            DateTime  @default(now())
  confirmation_expires_at DateTime?
  erase_by                DateTime
  processing_started_at   DateTime?
  attempt_count           Int       @default(0)
  completed_at            DateTime?
  expires_at              DateTime
  error_code              String?
  error_at                DateTime?

  @@index([status, requested_at])
  @@index([completed_at])
  @@index([expires_at])
  @@map("account_deletion_requests")
}

// ============================================================================
// DATABASE RPC FUNCTIONS (documented — not managed by Prisma)
// ============================================================================
//
// The following PostgreSQL functions are called as RPCs from the application
// layer. They exist in the database but Prisma cannot define raw SQL
// functions in the schema. They must be created via raw migrations.
//
// 1. generate_invite_token() RETURNS TEXT
//    Generates a unique invite token string: 'inv_' || uuid without dashes.
//    Source: 20251103_guest_crew_features.sql
//
// 2. increment_token_usage(token_input TEXT, user_id_input UUID) RETURNS BOOLEAN
//    Atomically increments usage count for an invite token, validates
//    active/expiry/max_uses, and appends to uses_log JSONB array.
//    Source: 20251103_guest_crew_features.sql
//
// 3. convert_guest_to_crew(p_guest_id UUID, p_converted_by UUID,
//    p_conversion_type TEXT DEFAULT 'host_promoted') RETURNS UUID
//    Promotes an event guest to a host's crew member: creates a connection
//    row and logs the conversion in guest_crew_conversions. Returns the
//    new connection_id.
//    Source: 20251103_guest_crew_features.sql
//
// 4. get_mutual_crew_count(user1 UUID, user2 UUID) RETURNS INTEGER
//    Returns the count of users that both user1 and user2 follow (mutual
//    crew overlap). Uses INTERSECT on connections.following_id.
//    Source: 20251101_partycrew_social_network.sql
//
// 5. is_following(follower UUID, following UUID) RETURNS BOOLEAN
//    Checks if `follower` follows `following`.
//    Source: 20251101_partycrew_social_network.sql
//
// 6. is_mutual_crew(user1 UUID, user2 UUID) RETURNS BOOLEAN
//    Checks if user1 and user2 mutually follow each other.
//    Source: 20251101_partycrew_social_network.sql
//
// 7. is_invite_token_valid(token_input TEXT) RETURNS BOOLEAN
//    Checks if an invite token is active, not expired, and under max_uses.
//    Source: 20251103_guest_crew_features.sql
//
// 8. check_poll_consensus() RETURNS TRIGGER
//    Trigger function: after a poll vote, checks if consensus threshold is
//    met and auto-closes the poll if so.
//    Source: 20251107_polls_feature.sql
//
// 9. update_event_cost_summary() RETURNS TRIGGER
//    Trigger function: recalculates event_cost_summaries after cost_split_
//    requests change.
//    Source: 20251103_guest_crew_features.sql
//
// 10. increment_template_usage() RETURNS TRIGGER
//     Trigger function: increments templates.usage_count after a new
//     template_usage row is inserted.
//     Source: 20251021175558_add_event_templates_system.sql
//
// 11. handle_new_user_profile() RETURNS TRIGGER
//     Trigger function: auto-creates a user_profiles row when a new auth
//     user is registered. Generates a unique username from email.
//     Source: 20260623_auto_create_user_profiles.sql
//
// ============================================================================
// VIEWS (documented — not managed by Prisma)
// ============================================================================
//
// email_analytics — aggregated email delivery metrics per event.
//   Columns: event_id, event_name, total_emails_sent, delivered_count,
//   opened_count, clicked_count, bounced_count, failed_count, delivery_rate,
//   open_rate, click_rate.
//   Source: 20250914120000_email_tracking.sql
// ============================================================================

// ============================================================================
// Billing, metering and onboarding research (20260913)
// ============================================================================

/// One row per user, holding the FACTS a provider told us.
///
/// ENTITLEMENT IS COMPUTED, NOT STORED
///   There is no `is_entitled` column, on purpose. Entitlement is a projection
///   over `status`, `trial_ends_at` and `current_period_end`, computed by
///   server/lib/entitlement.ts and computed once, server-side, for both
///   clients. A stored boolean is a cache, and a cache of a time-dependent
///   fact goes stale silently: a trial that expired at 03:00 would keep
///   granting access until something happened to rewrite the row.
///
/// TWO PROVIDERS, ONE ROW
///   Stripe (web) and Apple (StoreKit) both write here. `source` records which
///   one is currently authoritative. Apple owns trial eligibility for its own
///   purchases (introductory offers are per-Apple-ID, not per-PartyHause
///   account), so for `source = 'apple'` the trial columns below are a MIRROR
///   of what StoreKit reported, never the authority.
///
/// WHY NOT COLUMNS ON `User`
///   `middleware/auth.ts` selects from `users` on every authenticated request.
///   That select is already the hottest path in the API and does not need to
///   carry billing. `UserProfile` is worse: `GET /api/users/:id` exposes it to
///   other viewers, and an entitlement leak there is a privacy defect.
model Subscription {
  id      String @id @default(dbgenerated("gen_random_uuid()"))
  user_id String @unique

  /// CHECK: IN ('free', 'creator', 'vendor')
  plan String @default("free")

  /// CHECK: IN ('none','trialing','active','past_due','canceled','expired')
  ///
  /// Deliberately NOT `users.account_status`. Any value there other than
  /// 'active' currently means "cannot authenticate at all"
  /// (server/middleware/auth.ts:133), so putting 'past_due' in it would lock
  /// a paying customer out of the account they are trying to pay for.
  status String @default("none")

  /// CHECK: IN ('none', 'stripe', 'apple')
  source String @default("none")

  /// Null means eligible. The card-on-file trial. One per account, ever.
  ///
  /// There is exactly one trial. A no-card trial was designed and then cut:
  /// the onboarding paywall is hard, and a free path beside it would make it
  /// soft. Its column is not left behind "in case", because an unused column
  /// implying a feature that does not exist is how `Guest.payment_intent_id`
  /// came to suggest a Stripe integration this repository never had.
  card_trial_started_at DateTime?

  /// When the current trial ends, whichever kind it is.
  trial_ends_at DateTime?

  current_period_end   DateTime?
  cancel_at_period_end Boolean   @default(false)

  /// The first time real money was taken, ever. Null means never.
  ///
  /// This is the only fact that separates "your subscription ended" from
  /// "your trial ended", and the two need different copy and a different
  /// call to action. It cannot be inferred from the other columns:
  /// `card_trial_started_at` is set when a card trial BEGINS, so a trial that
  /// lapsed without converting looks identical to a subscription that ended,
  /// and Stripe populates `current_period_end` during a trial too.
  first_paid_at DateTime?

  stripe_customer_id     String? @unique
  stripe_subscription_id String? @unique

  /// Apple's stable per-subscription identifier. Survives renewals, so it is
  /// the only id safe to key a StoreKit subscription on.
  apple_original_transaction_id String? @unique

  /// Optimistic concurrency, matching the /api/mvp convention. Two webhooks
  /// arriving out of order must not silently overwrite each other.
  revision Int @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([trial_ends_at])
  @@map("subscriptions")
}

/// Append-only record of model turns, for the lifetime free quota.
///
/// WHY A TABLE AND NOT A COUNTER
///   A counter column cannot answer "which of these were billable". Every
///   rate limiter in this API is express-rate-limit's in-memory store: per
///   replica, reset on every deploy, and with maxReplicas 3 the real limit is
///   up to triple the nominal one. None of them can back a quota that must
///   hold for the life of an account.
///
/// WHY `source` IS RECORDED
///   `runChatTurn` falls back to a free deterministic extractor whenever the
///   LLM is unconfigured, times out, or returns something unparseable
///   (server/lib/event-chat.ts:291-298). The user cannot tell the difference.
///   Counting a heuristic reply against the quota would charge for something
///   the model never produced, so the quota counts `source = 'llm'` only and
///   the rest are kept for observability.
model AiUsage {
  id      String @id @default(dbgenerated("gen_random_uuid()"))
  user_id String

  /// CHECK: IN ('llm', 'heuristic')
  source String

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// The quota query: count llm turns for one user, ever.
  @@index([user_id, source])
  /// Observability and any future windowed quota.
  @@index([user_id, created_at])
  @@map("ai_usage")
}

/// Provider webhook ledger. At-least-once delivery made idempotent.
///
/// Modelled on `MvpCommand`, which already solves this for /api/mvp writes,
/// but deliberately a separate table: MvpCommand cascades on user delete and
/// expires after 24 hours, and billing evidence must outlive both. A provider
/// retry window is longer than a day, and a dispute can arrive after the
/// account is gone.
model BillingEvent {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  /// CHECK: IN ('stripe', 'apple')
  provider String

  /// The provider's own event id. Unique per provider, which is what makes a
  /// redelivery a no-op rather than a double-apply.
  provider_event_id String

  event_type String

  /// SHA-256 of the canonical payload. A replay carrying the SAME id but a
  /// DIFFERENT body is a fault worth surfacing, not a duplicate to swallow.
  payload_hash String

  /// CHECK: IN ('pending','applied','ignored','failed')
  status String @default("pending")

  /// Null until terminal. Set with the outcome, so a failed apply can be
  /// retried by hand without guessing what already happened.
  error String?

  received_at DateTime  @default(now())
  applied_at  DateTime?

  @@unique([provider, provider_event_id])
  @@index([status, received_at])
  @@map("billing_events")
}

/// What a user told us about how they want to run events.
///
/// Explicit columns rather than a JSON blob, because these answers drive
/// segmentation and the paywall's own copy, and a blob cannot be queried
/// without a migration anyway. `schema_version` records WHICH question set was
/// answered, so a later revision does not silently reinterpret old rows as
/// answers to questions nobody was asked.
///
/// Partial rows are the normal case: the flow asks across several screens and
/// a user may leave at any point. `completed_at` is null until the last screen
/// is submitted, and every answer column is nullable.
model OnboardingResponse {
  id      String @id @default(dbgenerated("gen_random_uuid()"))
  user_id String @unique

  /// Which question set this row answers. See server/lib/onboarding-questions.ts.
  schema_version String

  /// Who they are and at what scale.
  organizer_type      String?
  events_per_year     String?
  typical_guest_count String?

  /// Where they want the model to help, across the event lifecycle. Arrays
  /// because these are multi-select and the combination is the interesting
  /// signal, not any single choice.
  ai_before String[] @default([])
  ai_during String[] @default([])
  ai_after  String[] @default([])

  /// How much the model may do without being asked.
  /// CHECK: IN ('suggest','draft','act_with_approval','act_autonomously')
  autonomy_level String?

  /// Specific agentic capabilities requested.
  agentic_wants String[] @default([])

  /// Event-type chips picked on the onboarding interests screen (Birthday,
  /// Wedding, Corporate, ...). Free strings: the chip vocabulary is a product
  /// decision that changes without a migration. Max 20 x 64 chars is enforced
  /// by the zod contract, not the database.
  event_interests String[] @default([])

  /// The "Get tips and event inspiration" switch from the onboarding profile
  /// screen. False is both the default and the absence of consent.
  marketing_opt_in Boolean @default(false)

  /// One free-text answer. Kept short deliberately; this is a survey, not a
  /// support ticket.
  biggest_pain String?

  /// Null until the final screen is submitted.
  completed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([completed_at])
  @@index([organizer_type])
  @@index([event_interests], type: Gin)
  @@map("onboarding_responses")
}
