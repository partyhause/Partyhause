  saved_at DateTime @default(now())

  user  UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event Event       @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_id])
  @@index([user_id])
  @@index([event_id])
  @@map("saved_events")
}

