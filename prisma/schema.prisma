  @@index([follower_id])
  @@index([following_id])
  @@map("connections")
}

// PartyBoard persistence is modelled by PartyBoardSticky, PartyBoardStickyVote
// and PartyBoardTask further down this file. An earlier draft of this schema
// carried a second model over the same `partyboard_stickies` table holding
// `vote_count`, `voter_ids` and `reaction_count` as columns. That is the shape
// currently deployed, and it is why the baseline migration creates the table
// that way, but it is not the shape the application wants: a counter cannot
// answer `user_has_voted` for a given viewer, and a JSONB array of ids cannot
// make a repeated click a toggle rather than a second vote. The reconciliation
// lives in 20260909000000_partyboard_vote_tables, which preserves the existing
// voter_ids by migrating them into rows.

// Legacy web bookmarks. Excluded from IOS-MVP-1 but retained for schema parity.
model SavedEvent {
  id       String   @id @default(dbgenerated("gen_random_uuid()"))
  user_id  String
