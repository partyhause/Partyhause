FROM nginx:alpine

WORKDIR /app

# Pre-built Vite PWA bundle copied from host (built with `npm run build:web`).
COPY dist/ /usr/share/nginx/html

# Serve PWA via nginx on port 80 (compose maps host 5174 -> container 80).
# Proxy /api/* to Django API container on compose network.
COPY docker/nginx.dev.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
