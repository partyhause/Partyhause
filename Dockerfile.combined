# --- Build stage: web (identical to Dockerfile's builder) ---
FROM node:22.22.0-slim AS webbuilder
WORKDIR /app

COPY package.json package-lock.json ./
# --legacy-peer-deps is required, not defensive. The lockfile is written by a
# resolver running with that flag, and bare `npm ci` recomputes an ideal tree
# that disagrees with it, then refuses to install. See Dockerfile for the full
# note; the guard lives in src/test/install-paths.test.ts.
RUN npm ci --legacy-peer-deps

COPY . .

# Build the shared core package first (required by src/lib/api-client.ts)
RUN npm run build --workspace=packages/core

# Vite inlines VITE_* env vars at BUILD time, so they must be supplied as
# build args here (not runtime env vars). For the combined image VITE_API_URL
# is normally left EMPTY: nginx proxies /api/* to the API sidecar over
# localhost, so the browser sends same-origin relative requests and no CORS
# configuration is consulted at all (src/lib/apiBase.ts:9-12 documents the
# empty-base contract). Set VITE_API_URL only when pointing the bundle at a
# remote API.
ARG VITE_API_URL
ARG VITE_APP_NAME=PartyHause
ARG VITE_APP_URL
ARG VITE_ENTRA_TENANT_ID
ARG VITE_ENTRA_SPA_CLIENT_ID
ARG VITE_ENTRA_POLICY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_NAME=$VITE_APP_NAME
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_ENTRA_TENANT_ID=$VITE_ENTRA_TENANT_ID
ENV VITE_ENTRA_SPA_CLIENT_ID=$VITE_ENTRA_SPA_CLIENT_ID
ENV VITE_ENTRA_POLICY=$VITE_ENTRA_POLICY

# Fix tsconfig for web build (remove expo dependency)
RUN sed -i '/"extends": "expo/d' tsconfig.json || true

# Build the Vite PWA
RUN npm run build:web

# --- Build stage: API runtime (identical to Dockerfile.api's runtime) ---
FROM node:22.22.0-slim AS apibuilder
WORKDIR /app

# See Dockerfile: the lockfile is written with --legacy-peer-deps and bare
# `npm ci` rejects it with a picomatch conflict that looks like corruption.
# Both stages of this image need the flag.
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY . .

# Build the shared core package (required by server routes)
RUN npm run build --workspace=packages/core

# Generate Prisma client
RUN npx prisma generate

# --- Runtime stage: nginx front door + Express API sidecar ---
# One container serves frontend and backend on one origin. nginx owns port 80
# (the Container App ingress targetPort) and serves the static bundle with the
# full cache policy in nginx.conf, unchanged. It also proxies /api/* to the
# Express process listening on localhost:3001 in the same network namespace,
# so the browser never makes a cross-origin request and CORS_ALLOWED_ORIGINS
# stops mattering for the web app entirely.
#
# The prior topology was two Container Apps joined only by a VITE_API_URL baked
# into the bundle plus a CORS allowlist; one deploy moved the API and every
# client had to be rebuilt to follow it. Here one revision update moves both.
FROM node:22.22.0-slim
WORKDIR /app

# nginx, tini (PID 1 reaps the sidecar and forwards signals), and OpenSSL plus
# ca-certificates for sslmode=require against Azure PostgreSQL. tini is in the
# Debian repos; Alpine's nginx would need a different package set, and the API
# runtime above is already node:22-slim.
#
# Pipeline-Depth 0: apt's default pipelining against deb.debian.org (a Fastly
# CDN) intermittently corrupts fetched .debs here — the file size matches the
# manifest but the SHA256 does not, on a different package each run, and the
# build dies with "Hash Sum mismatch". Standalone `apt-get download` of the
# same package is byte-identical every time; the fault only appears when many
# requests share a connection. Disabling pipelining forces one request per
# file and the install passes. No-Cache stops apt reusing a corrupted response
# that a retry would otherwise hit.
RUN echo 'Acquire::http::Pipeline-Depth "0"; Acquire::http::No-Cache true;' \
      > /etc/apt/apt.conf.d/99nocache \
  && apt-get update \
  && apt-get install -y --no-install-recommends nginx tini openssl ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

# tsx runs the TypeScript server directly (package.json "server" script does
# the same); it is a devDependency, so --omit=dev drops it and the runtime
# image must install it itself. Dockerfile.api carries the same line.
RUN npm install -g tsx@4.22.4

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps

# Copy server code (TypeScript routes + lib + middleware)
COPY server/ ./server/

# Copy Prisma schema and generated client
COPY prisma/ ./prisma/
COPY prisma.config.ts ./
COPY --from=apibuilder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=apibuilder /app/node_modules/@prisma ./node_modules/@prisma
# The full transitive closure of @prisma/config (loaded by prisma.config.ts at
# runtime), computed from the lockfile tree. Copying only the direct deps
# fails one module at a time ("Cannot find module 'effect'", then 'fast-check',
# then 'pure-rand', ...). This list is every package reachable from
# @prisma/config's dependency graph; prune it only by re-running the closure.
COPY --from=apibuilder /app/node_modules/@standard-schema ./node_modules/@standard-schema
COPY --from=apibuilder /app/node_modules/anymatch ./node_modules/anymatch
COPY --from=apibuilder /app/node_modules/binary-extensions ./node_modules/binary-extensions
COPY --from=apibuilder /app/node_modules/braces ./node_modules/braces
COPY --from=apibuilder /app/node_modules/c12 ./node_modules/c12
COPY --from=apibuilder /app/node_modules/chokidar ./node_modules/chokidar
COPY --from=apibuilder /app/node_modules/confbox ./node_modules/confbox
COPY --from=apibuilder /app/node_modules/deepmerge-ts ./node_modules/deepmerge-ts
COPY --from=apibuilder /app/node_modules/defu ./node_modules/defu
COPY --from=apibuilder /app/node_modules/destr ./node_modules/destr
COPY --from=apibuilder /app/node_modules/dotenv ./node_modules/dotenv
COPY --from=apibuilder /app/node_modules/effect ./node_modules/effect
COPY --from=apibuilder /app/node_modules/empathic ./node_modules/empathic
COPY --from=apibuilder /app/node_modules/exsolve ./node_modules/exsolve
COPY --from=apibuilder /app/node_modules/fast-check ./node_modules/fast-check
COPY --from=apibuilder /app/node_modules/fill-range ./node_modules/fill-range
COPY --from=apibuilder /app/node_modules/giget ./node_modules/giget
COPY --from=apibuilder /app/node_modules/glob-parent ./node_modules/glob-parent
COPY --from=apibuilder /app/node_modules/is-binary-path ./node_modules/is-binary-path
COPY --from=apibuilder /app/node_modules/is-extglob ./node_modules/is-extglob
COPY --from=apibuilder /app/node_modules/is-glob ./node_modules/is-glob
COPY --from=apibuilder /app/node_modules/is-number ./node_modules/is-number
COPY --from=apibuilder /app/node_modules/jiti ./node_modules/jiti
COPY --from=apibuilder /app/node_modules/normalize-path ./node_modules/normalize-path
COPY --from=apibuilder /app/node_modules/ohash ./node_modules/ohash
COPY --from=apibuilder /app/node_modules/pathe ./node_modules/pathe
COPY --from=apibuilder /app/node_modules/perfect-debounce ./node_modules/perfect-debounce
COPY --from=apibuilder /app/node_modules/picomatch ./node_modules/picomatch
COPY --from=apibuilder /app/node_modules/pkg-types ./node_modules/pkg-types
COPY --from=apibuilder /app/node_modules/pure-rand ./node_modules/pure-rand
COPY --from=apibuilder /app/node_modules/rc9 ./node_modules/rc9
COPY --from=apibuilder /app/node_modules/readdirp ./node_modules/readdirp
COPY --from=apibuilder /app/node_modules/to-regex-range ./node_modules/to-regex-range

# Copy built shared core package (required by server routes)
COPY --from=apibuilder /app/packages/core ./packages/core

# Create symlink for workspace package resolution
RUN mkdir -p node_modules/@partyhause && ln -sf ../../packages/core node_modules/@partyhause/core

# Copy template data (used by seed and event-templates route)
COPY server/data/ ./server/data/

# Entrypoint that starts the API sidecar and supervises nginx
COPY docker/entrypoint.sh docker/entrypoint.sh

# Static bundle from the web builder
COPY --from=webbuilder /app/dist /usr/share/nginx/html

# Full cache policy plus the /api proxy. See nginx.conf for the reasoning.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Debian's nginx ships sites-enabled/default, a demo server block carrying
# `default_server` on port 80 and `server_name _`. It wins over the conf.d
# server (nginx logs "conflicting server name" and ignores ours), so every
# request is answered from /var/www/html with the distro's default page and
# none of the cache policy applies. The Alpine base of Dockerfile had no
# such file, which is why this only bites the combined image.
RUN rm -f /etc/nginx/sites-enabled/default

# Fail the build rather than ship a container that will not start.
RUN nginx -t

EXPOSE 80

# tini is PID 1: it runs nginx in the foreground and reaps the node sidecar,
# so a crashed API does not leave a zombie and SIGTERM reaches both processes.
# The sidecar itself is started by docker/entrypoint.sh alongside nginx.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["docker/entrypoint.sh"]
